---
// Chân trang dùng chung mọi trang (tách khỏi index.astro để 10 trang tới
// không phải chép lại). Slot "giay-phep" chừa chỗ cho GiayPhepFfmpeg (T028,
// FR-018) gắn vào khi làm trang Tải về — chưa có T028 thì slot rỗng.
//
// T067 (đợt vá US1): khôi phục 3 hàng đã mất so với bản demo đã duyệt — hàng
// kênh kết nối (KN-01/KN-02), hàng liên kết toàn trang, link Bài viết.
// Link kênh khai ở MỘT chỗ: `src/lib/kenhKetNoi.ts`. Kênh nào chưa có link
// thật (FR-021) thì hiện dạng chữ mờ "đang chờ", KHÔNG dùng href="#" giả vờ
// bấm được. YouTube đã có link thật từ 22/08/2026.
import { layKhoi } from "../lib/khoiNoiDung";
import { duongDan } from "../lib/duongDan";
import {
  LINK_YOUTUBE,
  LINK_FACEBOOK,
  LINK_TIKTOK,
  LINK_MESSENGER,
} from "../lib/kenhKetNoi";

const sm01 = await layKhoi("SM-01");
const gp05 = await layKhoi("GP-05");
const kn01 = await layKhoi("KN-01");
const kn02 = await layKhoi("KN-02");

const KENH: { nhan: string; href?: string }[] = [
  { nhan: "▶ YouTube", href: LINK_YOUTUBE },
  { nhan: "ⓕ Facebook", href: LINK_FACEBOOK },
  { nhan: "♪ TikTok", href: LINK_TIKTOK },
  { nhan: `💬 ${kn02.data.nut}`, href: LINK_MESSENGER },
];

const TRANG = [
  ["Trang chủ", ""],
  ["Tải về", "tai-ve/"],
  ["Ủng hộ", "ung-ho/"],
  ["Về CoClipNha", "gioi-thieu/"],
  ["Bài viết", "bai-viet/"],
  ["Hướng dẫn", "tro-giup/huong-dan/"],
  ["Câu hỏi", "tro-giup/cau-hoi/"],
  ["Mã QR điều khiển", "tro-giup/tai-qr/"],
  ["Góp ý", "tro-giup/gop-y/"],
  ["Báo lỗi", "tro-giup/bao-loi/"],
  ["Yêu cầu phần mềm", "tro-giup/yeu-cau-phan-mem/"],
];
---

<footer>
  <div class="logo-dong">
    <span class="logo-c" aria-hidden="true"></span>
    <strong style="color:var(--chu);">CoClipNha</strong>
  </div>
  <p>{sm01.data.cau_chot}</p>
  <p style="margin-top:.5rem;">
    {gp05.data.cau_chot} · Sponsored by ZIN ZIN MOTOR
  </p>

  <p class="hang-ket-noi">
    {
      KENH.map((kenh) =>
        kenh.href ? (
          <a class="link-kenh" href={kenh.href} rel="noopener">
            {kenh.nhan}
          </a>
        ) : (
          <span class="cho-link">{kenh.nhan} — đang chờ link</span>
        ),
      )
    }
  </p>
  <p class="chu-mo cho-ghi-chu">{kn01.data.dien_giai}</p>

  <p class="hang-trang">
    {
      TRANG.map(([ten, slug], i) => (
        <>
          {i > 0 && <span aria-hidden="true"> · </span>}
          <a href={duongDan(slug)}>{ten}</a>
        </>
      ))
    }
  </p>

  <slot name="giay-phep" />
</footer>

<style>
  .logo-c {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 2.5px solid var(--teal);
    border-right-color: transparent;
    position: relative;
    flex: none;
  }
  .logo-c::after {
    content: "";
    position: absolute;
    inset: 25%;
    background: var(--do);
    border-radius: 1.5px;
  }
  .hang-ket-noi {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1rem;
    margin-top: 1rem;
    font-size: 0.9rem;
  }
  /* Tài sản chờ cấp (FR-021): hiện gọn gàng, nói rõ đang chờ — không để link
     chết href="#" khiến người đọc bấm hụt. */
  .cho-link {
    color: var(--chu-mo);
    border: 1px dashed var(--vien);
    border-radius: 999px;
    padding: 0.1rem 0.9rem;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  /* Kênh ĐÃ có link thật: cùng dáng viên thuốc nhưng viền liền + chữ rõ, để
     nhìn ra ngay cái nào bấm được. */
  .link-kenh {
    color: var(--chu-diu);
    border: 1px solid var(--vien);
    border-radius: 999px;
    padding: 0.1rem 0.9rem;
    text-decoration: none;
    /* 44px = vùng chạm tối thiểu cho ngón tay (rà soát bố cục 24/08/2026).
       Dùng min-height + inline-flex thay vì padding dọc để viên thuốc không
       phình chữ ra, chỉ rộng vùng bấm. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .link-kenh:hover {
    color: var(--teal);
    border-color: var(--teal);
  }
  .cho-ghi-chu {
    font-size: 0.8rem;
    margin-top: 0.45rem;
  }
  .hang-trang {
    margin-top: 1rem;
    font-size: 0.85rem;
    /* line-height 2 cũ cho khoảng cách đẹp nhưng vùng bấm chỉ cao 17px —
       bấm hụt trên điện thoại. Nay lấy khoảng cách bằng padding của chính
       thẻ <a>, nên vùng chạm cao ~44px mà nhìn vẫn y như cũ. */
    line-height: 1.2;
  }
  .hang-trang a {
    display: inline-block;
    padding: 0.9rem 0.35rem;
  }
</style>
