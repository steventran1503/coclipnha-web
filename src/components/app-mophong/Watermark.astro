---
// Watermark mô phỏng đúng mẫu ghi thẳng lên video thật (T013 nguonSuThat.ts →
// watermark.cac_dong, record/recorder.py). Mặc định tĩnh có nghĩa khi tắt
// JavaScript (FR-010, T024): truyền sẵn `gio` là chuỗi giờ mẫu; có JS thì
// script bên dưới đổi thành đồng hồ thật đang chạy CHỈ khi gioSong=true.
//
// gioSong mặc định false: nhiều khối trên trang (vd GP-04 "hàng hoàn") cố ý
// đặt 2 Watermark cạnh nhau với 2 mốc giờ CỐ ĐỊNH khác nhau (lúc gửi / lúc
// nhận) để diễn ý "gửi đi ≠ nhận về" — nếu instance nào cũng tự chạy đồng hồ
// thật, cả hai sẽ bị ghi đè về cùng một giây, mất sạch ý so sánh đó. Chỉ nơi
// thật sự cần "đồng hồ đang chạy" (QuetThu, GP-03) mới bật gioSong.
import { watermark, dongQr } from "../../lib/nguonSuThat";

interface Props {
  maDon: string;
  gio?: string;
  gioSong?: boolean;
}

const { maDon, gio = "2026-07-25 09:12:30", gioSong = false } = Astro.props;

const dongThoiGian = watermark.cac_dong.find((d) => d.startsWith("Time: {")) ?? "Time: {timestamp}";
const dongBrand =
  watermark.cac_dong.find((d) => d.toLowerCase().includes("rec by")) ??
  "Rec by Coclipnha";
---

<div class="watermark" data-ma-don={maDon} data-gio-song={gioSong ? "1" : undefined}>
  <span data-vai="wm-qr">{dongQr(maDon)}</span><br />
  <span data-vai="wm-gio">{dongThoiGian.replace("{timestamp}", gio)}</span>
</div>
<div class="watermark-brand">{dongBrand}</div>

<style>
  .watermark {
    position: absolute;
    left: 0.9rem;
    bottom: 0.7rem;
    z-index: 4;
    font-family: var(--font-may);
    font-size: clamp(0.72rem, 1.9vw, 0.95rem);
    color: var(--wm);
    text-shadow:
      1px 1px 0 #000,
      -1px -1px 0 #000,
      1px -1px 0 #000,
      -1px 1px 0 #000;
    line-height: 1.5;
    white-space: nowrap;
  }
  .watermark-brand {
    position: absolute;
    right: 0.9rem;
    bottom: 0.7rem;
    z-index: 4;
    font-family: var(--font-may);
    font-size: 0.72rem;
    color: #ededed;
    text-shadow:
      1px 1px 0 #000,
      -1px -1px 0 #000;
  }
</style>

<script>
  // JS chỉ tăng cường: đổi dòng "Time:" sang đồng hồ thật của người xem đang
  // chạy — CHỈ cho instance có data-gio-song="1" (không JS, hoặc không bật
  // gioSong, watermark vẫn đủ nghĩa với giờ mẫu tĩnh render sẵn). Instance
  // không bật gioSong (vd 2 khung "gửi đi"/"nhận về" của GP-04) phải đứng
  // yên ở giờ cố định — không bị vòng lặp này đụng tới.
  function p2(n: number) {
    return (n < 10 ? "0" : "") + n;
  }
  function capNhat() {
    const d = new Date();
    const gio = `${d.getFullYear()}-${p2(d.getMonth() + 1)}-${p2(d.getDate())} ${p2(d.getHours())}:${p2(d.getMinutes())}:${p2(d.getSeconds())}`;
    document
      .querySelectorAll<HTMLElement>('.watermark[data-gio-song="1"] [data-vai="wm-gio"]')
      .forEach((el) => (el.textContent = `Time: ${gio}`));
  }
  capNhat();
  setInterval(capNhat, 1000);
</script>
