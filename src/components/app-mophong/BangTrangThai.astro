---
// Băng trạng thái mô phỏng — điểm ký tên của app trên web (FR-004, FR-006).
// Màu/chữ đọc từ nguonSuThat.ts, KHÔNG hardcode lại (contracts/nguon-su-that-contract.md).
// variant="trang": băng bám đỉnh toàn trang, đổi theo mục đang cuộn tới.
// variant="app": băng tĩnh bên trong cửa sổ app mô phỏng (nhỏ hơn, không sticky).
import {
  layChuBang,
  layGoiYBang,
  layMauBang,
  type TrangThaiBang,
} from "../../lib/nguonSuThat";

interface Props {
  trangThai: TrangThaiBang;
  maDon?: string;
  variant?: "trang" | "app";
  id?: string;
}

const { trangThai, maDon, variant = "trang", id } = Astro.props;
const mau = layMauBang(trangThai);
// Chữ chính CÓ nối mã đơn khi đang ghi — app thật hiện
// "ĐANG GHI HÌNH: 861879430644" (ảnh `Screenshot app/dark thêm - đang ghi
// hình.png`). Đây là điểm PROMPT-SPEC-004 để ngỏ "chốt sau: gộp hay tách" —
// ảnh app thật trả lời: GỘP, nên bỏ nhãn "QR hiện tại" tách riêng.
const chu = layChuBang(trangThai, maDon);
const goiY = layGoiYBang(trangThai);
---

<div
  class={`bang-mophong bang-mophong--${variant}`}
  data-trang-thai={trangThai}
  data-ma-don={maDon}
  id={id}
  role="status"
  style={`--bang-nen:${mau.bg};--bang-chu:${mau.fg};`}
>
  <span class="cham" aria-hidden="true"></span>
  <span class="noi-dung">
    <span class="loi-chinh" data-vai="chu">{chu}</span>
    <span class="goi-y" data-vai="goi-y">{goiY}</span>
  </span>
  <span class="gio" aria-hidden="true">
    <span class="ngay" data-vai="ngay"></span>
    <span data-vai="gio">--:--:--</span>
    <span class="rec-dem" data-vai="rec"
      ><span class="cham-rec">●</span>
      <span data-vai="rec-gio">00:00</span></span
    >
  </span>
</div>

<style>
  .bang-mophong {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.62rem 1rem;
    background: var(--bang-nen);
    color: var(--bang-chu);
    font-family: var(--font-chu);
    transition:
      background 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.45s;
    min-height: 3.2rem;
  }
  .bang-mophong--trang {
    position: sticky;
    top: 0;
    z-index: 50;
    /* Chừa chỗ bên phải cho nút menu ☰ (position:fixed, top:0.9rem right:1rem,
       rộng 2.2rem — xem MenuBaGach.astro) đang nổi cùng góc, không thì giờ
       hiển thị bị nút menu đè lên. */
    padding-right: 3.6rem;
  }
  .bang-mophong--app {
    min-height: 2.4rem;
    padding: 0.45rem 0.8rem;
    font-size: 0.85rem;
  }
  .cham {
    width: 0.68rem;
    height: 0.68rem;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }
  .bang-mophong[data-trang-thai="rec"] .cham {
    animation: nhay 1s steps(2, start) infinite;
  }
  @keyframes nhay {
    50% {
      opacity: 0.15;
    }
  }
  .loi-chinh {
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: 0.01em;
    display: block;
  }
  .bang-mophong--app .loi-chinh {
    font-size: 0.9rem;
  }
  .goi-y {
    font-size: 0.8rem;
    opacity: 0.85;
    display: block;
    line-height: 1.35;
  }
  .bang-mophong--app .goi-y {
    font-size: 0.66rem;
  }
  .gio {
    margin-left: auto;
    text-align: right;
    font-family: var(--font-may);
    font-size: 0.95rem;
    white-space: nowrap;
    line-height: 1.35;
  }
  .bang-mophong--app .gio {
    font-size: 0.78rem;
  }
  .ngay {
    display: block;
    font-size: 0.68em;
    opacity: 0.85;
  }
  /* Bộ đếm REC nằm TRONG băng, dưới đồng hồ — đúng chỗ app thật đặt nó
     (ảnh `Screenshot app/dark thêm - đang ghi hình.png`), không phải chữ nổi
     trên khung hình. Chỉ hiện khi băng ở trạng thái "rec". */
  .rec-dem {
    display: none;
    font-size: 0.78em;
  }
  .bang-mophong[data-trang-thai="rec"] .rec-dem {
    display: block;
  }
  .cham-rec {
    animation: nhay 1s steps(2, start) infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .cham-rec {
      animation: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bang-mophong[data-trang-thai="rec"] .cham {
      animation: none;
    }
  }
  @media (max-width: 480px) {
    .goi-y {
      display: none;
    }
    .loi-chinh {
      font-size: 0.84rem;
    }
  }
</style>

<script>
  // JS chỉ tăng cường: đồng hồ thật của người xem. Không JS, ô giờ ẩn trống
  // (đã đặt aria-hidden), nội dung còn lại (trạng thái, chữ) vẫn đủ nghĩa.
  function p2(n: number) {
    return (n < 10 ? "0" : "") + n;
  }
  // Dạng ngày khớp app thật: "Thứ 6, 24/07/2026" (ảnh chụp màn hình app).
  const THU = [
    "Chủ nhật",
    "Thứ 2",
    "Thứ 3",
    "Thứ 4",
    "Thứ 5",
    "Thứ 6",
    "Thứ 7",
  ];
  function capNhat() {
    const d = new Date();
    const gio = `${p2(d.getHours())}:${p2(d.getMinutes())}:${p2(d.getSeconds())}`;
    const ngay = `${THU[d.getDay()]}, ${p2(d.getDate())}/${p2(d.getMonth() + 1)}/${d.getFullYear()}`;
    document
      .querySelectorAll<HTMLElement>('.bang-mophong [data-vai="gio"]')
      .forEach((el) => (el.textContent = gio));
    document
      .querySelectorAll<HTMLElement>('.bang-mophong [data-vai="ngay"]')
      .forEach((el) => (el.textContent = ngay));
  }
  capNhat();
  setInterval(capNhat, 1000);
</script>
