---
// Khối ảnh app ĐẦU TRANG CHỦ (trước đây gọi là "Quét thử").
//
// ĐỔI HƯỚNG 24/08/2026 — chủ dự án chốt sau khi tự xem trang trên điện thoại:
// bỏ hẳn phần dựng lại giao diện bằng HTML (component CuaSoApp + băng trạng
// thái + watermark + dòng nhật ký), thay bằng ẢNH CHỤP MÀN HÌNH THẬT, dùng
// CHUNG cho cả điện thoại lẫn máy tính.
//
// Vì sao đổi: bản dựng HTML co giãn theo bề ngang máy. Đo trên web thật ngày
// 24/08/2026: ở 390px (iPhone 12–15) cả cửa sổ cao 1.060px — hơn 1,3 màn hình
// điện thoại — mà khung camera chỉ còn 20% chiều cao, trong khi cụm thẻ phụ
// (thương hiệu, donate, nhân viên, hôm nay, ổ đĩa) rớt xuống thành một dãy dọc
// full chiều ngang chiếm 44%. Người xem đọc từ trên xuống ra "đây là app điện
// thoại", tức hiểu sai chính thứ mình đang bán. Ảnh chụp thì KHÔNG co giãn
// được: tỉ lệ bố cục giữ y nguyên trên mọi máy.
//
// Cái mất đã cân nhắc và chấp nhận: chữ trong app thu nhỏ theo bề ngang máy.
// Bù lại bằng tấm cỡ gốc trong `srcset` (máy màn hình nét lấy tấm nét) và link
// "xem ảnh to" đặt dưới ảnh ở trang chủ.
//
// ⛔ KHÔNG phủ tối tấm ảnh này và KHÔNG đặt chữ đè lên nó. Ô video VD-01 phủ
// tối 45% vì ở đó ảnh chỉ làm NỀN cho chữ; ở đây ảnh CHÍNH LÀ nội dung — phủ
// tối hay che chữ lên là xoá đúng thứ người xem cần đọc. Mọi chú thích nằm
// DƯỚI ảnh (viết ở src/pages/index.astro ngay sau khối này).
//
// Ảnh đã làm mờ tên / số điện thoại / địa chỉ khách, mã QR trên tem và người
// soi trong gương phía sau — đọc
// chú thích ANH_APP_DANG_GHI ở src/lib/video.ts trước khi thay ảnh khác.
import { duongDan } from "../../lib/duongDan";
import { ANH_APP_DANG_GHI, ANH_APP_DANG_GHI_2X } from "../../lib/video";

interface Props {
  /**
   * Mã video YouTube demo ngắn. Tài sản chờ chủ dự án cấp
   * (`tests/tai-san-cho-cap.md` mục 8a) — CHƯA có mã thì KHÔNG hiện nút play
   * (FR-021: không mời bấm vào chỗ chưa có gì); câu "video sắp có" nói ở dòng
   * chú thích dưới ảnh. Có mã là nút play đỏ tự hiện giữa ảnh.
   */
  videoId?: string;
}
const { videoId } = Astro.props;

const ALT_ANH =
  "Phần mềm quay video bằng mã QR vận đơn CoClipNha — ảnh chụp màn hình thật: app đang ghi hình một đơn, mã đơn và giờ hiện ngay trên khung hình, camera soi tem vận đơn tại bàn gói của shop";
// sizes="100vw": khung ảnh chiếm gần trọn cột chữ ở mọi bề ngang (đo 24/08/2026:
// 1.048px trên máy 1280px, 358px trên iPhone 390px), nên khai 100vw là máy màn
// hình nét tự lấy tấm cỡ gốc. `loading="lazy"`: khối này nằm dưới màn hình đầu
// (đo: cách đỉnh trang 979px trên điện thoại) — đặt eager là giành đường truyền
// với phần chữ đầu trang, làm tụt điểm tốc độ.
const ANH_1X = duongDan(ANH_APP_DANG_GHI);
const ANH_2X = duongDan(ANH_APP_DANG_GHI_2X);
---

<div class="anh-app" id="quet-thu" data-video-id={videoId}>
  <div class="khung-anh" data-vai="khung">
    <img
      src={ANH_1X}
      srcset={`${ANH_1X} 1280w, ${ANH_2X} 1671w`}
      sizes="100vw"
      alt={ALT_ANH}
      width="1280"
      height="720"
      loading="lazy"
      decoding="async"
    />
    {
      videoId && (
        /* Mặt tiền giả (FR-009): KHÔNG nạp iframe cho tới khi người xem bấm.
           Không JS thì thẻ <a> vẫn mở thẳng video trên YouTube — ngõ ra thật,
           không phải nút chết. */
        <a
          class="nut-play-anh"
          data-vai="nut"
          href={`https://www.youtube.com/watch?v=${videoId}`}
          rel="noopener"
          aria-label="Xem đoạn quay màn hình app chạy thật"
        >
          <span aria-hidden="true">▶</span>
        </a>
      )
    }
  </div>
</div>

<style>
  .khung-anh {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--vien);
    background: #0b0e14;
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.5);
  }
  .khung-anh img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Nút play: 4,4rem ≈ 70px — vượt mức chạm tối thiểu 44px (rà soát 24/08).
     Vòng tối quanh nút để nút không lẫn vào chỗ sáng của ảnh. */
  .nut-play-anh {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    background: var(--do);
    color: #fff;
    font-size: 1.4rem;
    text-decoration: none;
    box-shadow: 0 0 0 6px rgba(8, 11, 16, 0.45);
  }

  /* Khi đã bấm: iframe thế chỗ cả tấm ảnh, giữ nguyên khung bo góc bao quanh. */
  .khung-anh :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    z-index: 8;
  }
</style>

<script>
  // JS chỉ tăng cường: bấm nút thì nạp video ngay trong khung ảnh bằng
  // youtube-nocookie.com (FR-009). Không JS, thẻ <a> mở YouTube ở tab
  // thường — vẫn xem được video, chỉ là rời trang.
  const goc = document.getElementById("quet-thu");
  const videoId = goc?.dataset.videoId;
  const nut = goc?.querySelector<HTMLAnchorElement>('a[data-vai="nut"]');
  const khung = goc?.querySelector<HTMLElement>('[data-vai="khung"]');

  if (goc && videoId && nut && khung) {
    nut.addEventListener("click", (e) => {
      e.preventDefault();
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
      iframe.title = "CoClipNha chạy thật trên bàn đóng gói";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      khung.appendChild(iframe);
      nut.remove();
    });
  }
</script>
