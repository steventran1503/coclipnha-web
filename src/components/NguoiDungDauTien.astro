---
// Khối "Người dùng đầu tiên" — dùng chung ở US1 (trang chủ) và US4 (Ủng hộ).
// LUẬT (kho-thong-diep.md §7e, DG-01): không bịa đánh giá, không gắn sao —
// FR-019. Chỉ 1 dẫn chứng thật (BC-01, ZIN ZIN MOTOR) + ô trống ghi rõ lý do.
//
// Dùng cau_chot (câu chốt ngắn) chứ KHÔNG dùng dien_giai của BC-01: trang chủ
// (index.astro mục "BC-01 + TN") đã in dien_giai đầy đủ ngay phía trên khối
// này — dùng lại y nguyên đoạn đó ở đây sẽ lặp chữ 2 lần liền kề trên cùng
// trang. cau_chot là câu ngắn hơn, không trùng.
//
// Câu "Ô này để trống…" nay đọc thẳng từ khối DG-01 (T053, đợt vá US1
// 25/07/2026). Trước đó phải chép cứng vì `xuat_kho_noi_dung.py` không trích
// được câu nằm trong bullet "Cách dựng khi chưa có" — đã sửa: DG-01 giờ có
// nhãn **Câu chốt**/**Diễn giải** riêng trong kho-thong-diep.md và script đọc
// được trọn bullet nhiều dòng. KHÔNG chép cứng lại chữ ở đây (FR-003, SC-003).
import { layKhoi } from "../lib/khoiNoiDung";

const bc01 = await layKhoi("BC-01");
const dg01 = await layKhoi("DG-01");
---

<div class="nguoi-dung-dau-tien">
  <div class="the-app">
    <div class="tieu-de-the">ZIN ZIN MOTOR — phụ tùng xe máy</div>
    <p>{bc01.data.cau_chot}</p>
  </div>
  <p class="ghi-chu">{dg01.data.dien_giai}</p>
</div>

<style>
  .nguoi-dung-dau-tien {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .the-app {
    background: var(--the);
    border: 1px solid var(--vien);
    border-radius: 10px;
    padding: 1rem 1.1rem;
  }
  .tieu-de-the {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--chu-mo);
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }
  .the-app p {
    font-size: 0.95rem;
    color: var(--chu-diu);
  }
  .ghi-chu {
    color: var(--chu-mo);
    font-size: 0.85rem;
  }
</style>
