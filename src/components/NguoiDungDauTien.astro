---
// Khối "Người dùng đầu tiên" — thẻ ĐỐI TÁC THỬ NGHIỆM (BC-03).
//
// TÁCH VAI 21/08/2026 (chủ dự án chốt): trước đây thẻ này lấy chữ từ BC-01,
// mà BC-01 khi đó kể "CoClipNha sinh ra từ bàn đóng gói của ZIN ZIN MOTOR" —
// đọc ra là phần mềm thuộc về một cửa hàng phụ tùng xe máy, và tiền ủng hộ
// chảy về đó. Nay tách đôi:
//   · BC-01 = đội ngũ phát triển (ai làm ra phần mềm, tiền ủng hộ nuôi gì)
//   · BC-03 = ZIN ZIN MOTOR — đối tác thử nghiệm + shop dùng đầu tiên
// ĐỪNG gộp lại. Xem LUẬT trong khối BC-03 (kho-thong-diep.md mục 6).
//
// LUẬT (kho-thong-diep.md §7e, DG-01): không bịa đánh giá, không gắn sao —
// FR-019. Thẻ này PHẢI mang nhãn vai "đối tác thử nghiệm" để không bị đọc nhầm
// thành lời khen của một khách hàng độc lập.
//
// Nhãn vai + tên shop là nhãn cấu trúc trang (như tít mục) nên không vào kho nội
// dung, theo ranh giới đã chốt ở README-noi-dung.md. Còn chữ thân thẻ thì đọc
// từ kho, KHÔNG chép cứng (FR-003, SC-003).
import { layKhoi } from "../lib/khoiNoiDung";

interface Props {
  /** Hiện câu "ô này để trống cho tới khi có đánh giá thật" (DG-01). Chỉ
   * bật ở chỗ thẻ đứng trong mục Đánh giá (trang chủ); trang "Về CoClipNha"
   * kể xuất xứ nên không cần. */
  hienGhiChuDanhGia?: boolean;
}
const { hienGhiChuDanhGia = true } = Astro.props;

const bc03 = await layKhoi("BC-03");
const dg01 = await layKhoi("DG-01");
---

<div class="nguoi-dung-dau-tien">
  <div class="the-app">
    <div class="hang-tieu-de">
      <span class="tieu-de-the">ZIN ZIN MOTOR</span>
      <span class="nhan-vai">đối tác thử nghiệm</span>
    </div>
    <p>{bc03.data.dien_giai}</p>
  </div>
  {hienGhiChuDanhGia && <p class="ghi-chu">{dg01.data.dien_giai}</p>}
</div>

<style>
  .nguoi-dung-dau-tien {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .the-app {
    background: var(--the);
    border: 1px solid var(--vien);
    border-radius: 10px;
    padding: 1rem 1.1rem;
  }
  .hang-tieu-de {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }
  .tieu-de-the {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--chu-mo);
    text-transform: uppercase;
  }
  .nhan-vai {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--chu-mo);
    border: 1px solid var(--vien);
    border-radius: 999px;
    padding: 0.12rem 0.5rem;
    white-space: nowrap;
  }
  .the-app p {
    font-size: 0.95rem;
    color: var(--chu-diu);
  }
  .ghi-chu {
    color: var(--chu-mo);
    font-size: 0.85rem;
  }
</style>
