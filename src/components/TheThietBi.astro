---
// Thẻ một thiết bị đề xuất — dùng chung cho trang Tải về và trang Thiết bị
// đề xuất, nên đổi kiểu dáng một lần là hai trang cùng đổi.
//
// FR-008: câu công khai hoa hồng (CAU_MINH_BACH) gắn cứng vào thẻ, ngay dưới
// nút mua. Không có công tắc nào tắt được từ file dữ liệu — cố ý như vậy.
import {
  CAU_MINH_BACH,
  danhXung,
  loaiCua,
  tenDayDu,
  type ThietBi,
} from "../lib/thietBi";
import { duongDan } from "../lib/duongDan";

interface Props {
  thietBi: ThietBi;
  /** true = bản gọn cho trang Tải về (không hiện ảnh lớn). */
  gon?: boolean;
}
const { thietBi: tb, gon = false } = Astro.props;
// Thẻ dùng chung cho camera lẫn phụ kiện → chữ trên nút, mô tả ảnh và ô chờ
// ảnh phải gọi đúng tên món, không được ghi cứng "camera" như bản đầu.
const laPhuKien = loaiCua(tb) === "phu_kien";
const nhan = danhXung(tb); // "camera" | "giá đỡ" | "màn hình"
// Biểu tượng ô chờ ảnh, theo loại món. Thêm loại mới vào JSON mà quên thêm
// vào đây thì TypeScript báo lỗi ngay lúc build — cố ý khai đủ khoá.
const BIEU_TUONG = { camera: "📷", phu_kien: "🔩", man_hinh: "🖥️" };
const nhanHoa = nhan.charAt(0).toUpperCase() + nhan.slice(1);
---

<div class="the-app the-app--teal the-tb">
  {
    !gon &&
      (tb.anh ? (
        <img
          class="anh-tb"
          src={duongDan(`anh/${tb.anh}`)}
          alt={
            /* Tên phụ kiện đã tự chứa chữ "giá đỡ" → đừng ghép thêm lần nữa. */
            laPhuKien ? `Ảnh ${tenDayDu(tb)}` : `${nhanHoa} ${tenDayDu(tb)}`
          }
          width="320"
          height="320"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="anh-tb anh-tb--cho" role="status">
          <span aria-hidden="true">{BIEU_TUONG[loaiCua(tb)]}</span>
          <span>Ảnh {nhan} sắp có</span>
        </div>
      ))
  }

  <div class="tieu-de-the">{tenDayDu(tb)}</div>
  <p class="vi-sao">{tb.vi_sao}</p>
  {tb.da_test && <p class="da-test">✔ {tb.da_test}</p>}

  <p class="hang-nut">
    {
      tb.link ? (
        <a
          class="nut nut--vien"
          href={tb.link}
          rel="nofollow sponsored noopener"
          target="_blank"
        >
          Xem {nhan}
          {tb.noi_ban ? ` trên ${tb.noi_ban}` : ""} →
        </a>
      ) : (
        <span class="nut nut--vien nut-cho" role="status">
          Link mua — sắp có
        </span>
      )
    }
  </p>
  <p class="minh-bach">{CAU_MINH_BACH}</p>
</div>

<style>
  .the-tb {
    display: flex;
    flex-direction: column;
  }
  .anh-tb {
    display: block;
    width: 100%;
    max-width: 12rem;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 8px;
    background: #0b0e14;
    margin-bottom: 0.9rem;
  }
  .anh-tb--cho {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 1px dashed var(--vien);
    color: var(--chu-mo);
    font-size: 0.82rem;
    text-align: center;
  }
  .vi-sao {
    font-size: 0.93rem;
    color: var(--chu-diu);
    margin-bottom: 0.6rem;
  }
  .da-test {
    font-size: 0.88rem;
    color: var(--teal);
    margin-bottom: 0.8rem;
  }
  .hang-nut {
    margin: auto 0 0.6rem;
  }
  .nut-cho {
    opacity: 0.75;
    cursor: default;
    font-size: 0.9rem;
  }
  /* Nhãn công khai hoa hồng: nhỏ nhưng luôn nằm sát nút, không đẩy xuống cuối
     trang (FR-008 — "ngay cạnh link"). Không kẻ vạch ngăn: nhãn nay rút còn
     hai chữ (19/08/2026), một đường kẻ ngang cả thẻ chỉ để đỡ hai chữ trông
     nặng hơn chính cái nó ngăn. */
  .minh-bach {
    font-size: 0.8rem;
    color: var(--chu-mo);
    margin: 0;
  }
</style>
