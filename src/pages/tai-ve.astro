---
// T029/T030 — US2 "Tải app và vượt SmartScreen yên tâm" (FR-015..FR-018).
//
// THỨ TỰ KHỐI — chốt 28/07/2026 (chủ dự án chọn "cách A"), đừng đảo lại:
//   KG-01 nút tải + nút Camera đề xuất → VIDEO CÀI ĐẶT (thêm 22/08/2026) →
//   PB-04 (2 hình SmartScreen T027) → PB-03 → TB-01 thân + TB-02 + thẻ thiết
//   bị → VD-01.
// Khối video cài đặt chèn ngay sau nút tải, KHÔNG đảo thứ tự các khối cũ.
//
// CÁCH GIỮ FR-015 KHI NÚT TẢI Ở TRÊN CÙNG — đọc kỹ trước khi sửa:
// FR-015 bắt "yêu cầu camera lấy nét tự động PHẢI xuất hiện TRƯỚC nút tải".
// Lý do có thật: shop tải về, cài xong mới biết webcam mình không lấy nét
// được thì mất công vô ích. Nên yêu cầu đó vẫn đứng trên nút — nhưng rút gọn
// còn ĐÚNG MỘT DÒNG (câu chốt TB-01) kèm liên kết #camera, còn phần thân dài
// đẩy xuống dưới. Đừng bỏ dòng .dieu-kien đó đi để "cho gọn": bỏ là vi phạm
// FR-015 ngay lúc điền link tải vào (đúng lỗi F1 đã bắt sáng 28/07).
//
// TB-01 và phần gợi ý mẫu là HAI khối tách bạch, không được gộp: gộp lại thì
// người đọc tưởng phải mua đúng hãng mới chạy được app (ghi chú "VIẾT SAO CHO
// ĐÚNG" của chính khối TB-01).
//
// Mọi câu nội dung đọc qua layKhoi() (FR-003); chữ trong trang chỉ là nhãn
// điều hướng/tiêu đề mục.
import BaseLayout from "../layouts/BaseLayout.astro";
import SmartScreenHuongDan from "../components/SmartScreenHuongDan.astro";
import GiayPhepFfmpeg from "../components/GiayPhepFfmpeg.astro";
import YoutubeFacade from "../components/YoutubeFacade.astro";
// Video hướng dẫn đầy đủ (khối VD-01) — cùng mã video với trang chủ và
// trang Hướng dẫn, khai chung ở src/lib/video.ts. VIDEO_CAI_DAT là video
// RIÊNG của trang này (cài phần mềm vào máy), đừng lẫn với VIDEO_HUONG_DAN.
import { VIDEO_CAI_DAT, VIDEO_HUONG_DAN } from "../lib/video";
import TheThietBi from "../components/TheThietBi.astro";
import VanBan from "../components/VanBan.astro";
import { layKhoi } from "../lib/khoiNoiDung";
import { duongDan } from "../lib/duongDan";
import { thietBiGoiY } from "../lib/thietBi";

const kg01 = await layKhoi("KG-01");
const tb01 = await layKhoi("TB-01");
const tb02 = await layKhoi("TB-02");
const pb04 = await layKhoi("PB-04");
const pb03 = await layKhoi("PB-03");
const pb02 = await layKhoi("PB-02");
const vd01 = await layKhoi("VD-01");
const tt12 = await layKhoi("TT-12");
const tt13 = await layKhoi("TT-13");

// Câu "ngoài yêu cầu autofocus thì camera nào cũng chạy" — nằm ở bullet
// **Ngoài yêu cầu đó** của TB-01, gọi ĐÍCH DANH nhãn (xem chú thích
// `truong_khac` trong content.config.ts: cụm này còn chứa ghi chú nội bộ,
// tuyệt đối không đổ cả cụm ra trang).
const tb01Them = tb01.data.truong_khac["Ngoài yêu cầu đó"];

// T030/FR-016 — nút tải trỏ `…/releases/latest/download/…` nên LUÔN là bản
// mới nhất: phát hành bản sau chỉ cần tải file lên GitHub Releases, KHÔNG
// phải sửa dòng này.
//
// ĐIỀN THẬT 30/07/2026 — bản 2.2.0 đã nghiệm thu máy sạch. Đã thử tải qua
// đường này và đối chiếu SHA-256 khớp bản build trên máy.
//
// ⚠️ Tên file trên Releases PHẢI luôn là `CoClipNha-Setup.exe` (KHÔNG mang số
// phiên bản). Tải lên với tên có số là đường `latest/download` trả 404 và nút
// tải chết mà không ai hay — trang vẫn hiện nút xanh bình thường.
// ⚠️ Bản phát hành trên GitHub KHÔNG được tích "pre-release": đường
// `latest` bỏ qua bản pre-release.
//
// Đặt lại `null` là nút tự về trạng thái "sắp có" CÓ NGHĨA (không phải nút
// chết) — dùng khi cần tạm rút bản tải về.
const LINK_TAI: string | null =
  "https://github.com/steventran1503/coclipnha-web/releases/latest/download/CoClipNha-Setup.exe";

// Dữ liệu có cấu trúc cho Google (Schema.org SoftwareApplication) — khai đúng
// những gì có thật: phần mềm chạy Windows 10/11, giá 0 đồng, tiếng Việt.
//
// KHÔNG khai `aggregateRating` hay `review`: chưa có đánh giá khách hàng thật
// nào (FR-019). Khai sao giả là lý do Google phạt tay, mà cũng đi ngược đúng
// thứ cả web này đang bán — chữ tin.
//
// `downloadUrl` chỉ khai khi đã có link tải thật; khai một đường dẫn không
// tồn tại thì Google báo lỗi dữ liệu có cấu trúc.
const schemaPhanMem = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "CoClipNha",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Windows 10, Windows 11",
  inLanguage: "vi",
  description:
    "Phần mềm ghi hình đóng gói cho shop bán hàng online: quét mã vận đơn là tự động quay, video mang tên mã đơn, đóng sẵn mã và giờ lên hình để làm bằng chứng chống tráo hàng.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "VND",
  },
  ...(LINK_TAI ? { downloadUrl: LINK_TAI } : {}),
};
---

<BaseLayout
  tieuDe="Tải CoClipNha — miễn phí cho Windows 10 và 11"
  moTaMeta="Tải CoClipNha về máy tính bàn gói hàng. Miễn phí, không cần tài khoản. Đọc trước yêu cầu camera và cách vượt cảnh báo Windows chỉ với 2 cú bấm."
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(schemaPhanMem)}
  />
  <main>
    {
      /* ====== KG-01: nút tải, ngay đầu trang — kèm ĐIỀU KIỆN đứng trước ====
        Điều kiện camera rút còn MỘT dòng (câu chốt TB-01) đặt trên nút, thoả
        FR-015; phần thân TB-01 + gợi ý mẫu nằm ở khối "Camera nào chạy tốt?"
        phía dưới, bấm nút cam là tới. */
    }
    <section class="khoi khoi--hep" data-bang="ready">
      <p class="lan-ve"><a href={duongDan()}>← Trang chủ</a></p>
      <span class="nhan-log">miễn phí</span>
      <h1>Tải CoClipNha</h1>
      <p class="dan-nhap">{kg01.data.dien_giai}</p>

      <p class="dieu-kien">
        <strong>Một điều kiện duy nhất:</strong>
        {tb01.data.cau_chot}{" "}
        <a href="#camera">Camera của shop có đạt không? →</a>
      </p>

      <p class="cho-nut">
        {
          LINK_TAI ? (
            <a class="nut nut--chinh nut--to" href={LINK_TAI} rel="noopener">
              {kg01.data.nut ?? kg01.data.cau_chot}
              <span class="co-file"> · 68 MB · Windows 10/11</span>
            </a>
          ) : (
            <span class="nut nut--to nut--sap-co" role="status">
              {kg01.data.nut ?? kg01.data.cau_chot} — sắp có
            </span>
          )
        }
        <a class="nut nut--cam nut--to" href={duongDan("thiet-bi/")}>
          📷 Camera đề xuất
        </a>
      </p>
      {
        !LINK_TAI && (
          <p class="chu-mo ghi-chu">
            Bản cài đang trong khâu đóng gói cuối. Trong lúc chờ, shop cứ đọc
            hết trang này — cảnh báo Windows lúc cài nằm ngay dưới đây, để lúc
            có bản cài là dùng được luôn.
          </p>
        )
      }
    </section>

    {
      /* ====== Video CÀI ĐẶT (thêm 22/08/2026) =============================
        Đặt ngay dưới nút tải vì đó đúng là việc kế tiếp shop phải làm: file
        vừa tải về rồi cài thế nào. Mã video khai ở src/lib/video.ts
        (VIDEO_CAI_DAT) — ĐỪNG ghi cứng mã vào đây. Tít mục là chữ chương
        trình (nhãn điều hướng), không phải câu kho thông điệp. Không có mã
        thì cả khối ẩn hẳn, không để lại ô chờ. */
    }
    {
      VIDEO_CAI_DAT && (
        <section class="khoi khoi--hep" data-bang="ready">
          <span class="nhan-log">xem trước khi cài</span>
          <h2>Tải xong rồi cài thế nào?</h2>
          <p class="mo-dau">
            Video quay màn hình các bước cài CoClipNha vào máy Windows.
          </p>
          <YoutubeFacade
            tieuDeVideo="Cách cài đặt CoClipNha"
            videoId={VIDEO_CAI_DAT}
          />
        </section>
      )
    }

    {/* ============ PB-04 + hình SmartScreen (T027) ============ */}
    <section class="khoi khoi--hep" data-bang="warn">
      <span class="nhan-log">đừng hoảng</span>
      <h2>{pb04.data.cau_chot}</h2>
      <SmartScreenHuongDan
        lyDo={pb04.data.dien_giai}
        chuThich={[
          [tt12.data.cau_chot, tt12.data.dien_giai],
          [tt13.data.cau_chot, tt13.data.dien_giai],
        ]}
      />
      <p class="chu-mo ghi-chu">
        <strong
          >Nhắc lại cho yên tâm — {pb02.data.cau_chot.toLowerCase()}</strong
        >{" "}{pb02.data.dien_giai}{" "}
        <a href={duongDan("tro-giup/cau-hoi/")}>Xem thêm câu hỏi thường gặp</a>.
      </p>
    </section>

    {/* ============ PB-03: máy yếu ============ */}
    <section class="khoi khoi--hep" data-bang="ready">
      <h2>{pb03.data.cau_chot}</h2>
      <p class="mo-dau">{pb03.data.dien_giai}</p>
    </section>

    {
      /* ====== TB-01 (thân) + TB-02 + thiết bị đề xuất ======================
        TB-01 và phần gợi ý mẫu là HAI khối tách bạch, không được gộp: gộp
        lại thì người đọc tưởng phải mua đúng hãng mới chạy được app (ghi chú
        "VIẾT SAO CHO ĐÚNG" của chính khối TB-01). */
    }
    <section class="khoi khoi--hep" data-bang="warn" id="camera">
      <span class="nhan-log">đọc trước khi mua camera</span>
      <h2>Camera nào chạy tốt?</h2>

      <div class="the-app the-app--do">
        <div class="tieu-de-the">{tb01.data.cau_chot}</div>
        <p>{tb01.data.dien_giai}</p>
        {tb01Them && <p class="them">Ngoài yêu cầu đó, {tb01Them}</p>}
      </div>

      <p class="mo-dau doan gioi-thieu-tb">
        <VanBan text={tb02.data.dien_giai} />
      </p>

      <div class="luoi-tb">
        {thietBiGoiY.map((tb) => <TheThietBi thietBi={tb} gon={true} />)}
      </div>

      <p class="chu-mo ghi-chu">
        Shop đang có sẵn camera lấy nét tự động thì dùng luôn, không cần mua
        thêm gì. <a href={duongDan("thiet-bi/")}>Xem kỹ từng mẫu →</a>
      </p>
    </section>

    {/* ============ VD-01: xem thử ============ */}
    <section class="khoi khoi--hep" data-bang="nen">
      <h2>{vd01.data.cau_chot}</h2>
      <p class="mo-dau doan">{vd01.data.dien_giai}</p>
      <YoutubeFacade
        tieuDeVideo={vd01.data.cau_chot}
        videoId={VIDEO_HUONG_DAN}
      />
    </section>
  </main>

  {/* FR-018: ghi nhận giấy phép ffmpeg, đặt ở chân trang dùng chung */}
  <GiayPhepFfmpeg slot="giay-phep" />
</BaseLayout>

<style>
  h1 {
    font-family: var(--font-tit);
    font-size: clamp(1.7rem, 5vw, 2.4rem);
    margin-bottom: 1.2rem;
  }
  h2 {
    font-family: var(--font-tit);
    font-size: 1.35rem;
    margin-bottom: 0.8rem;
  }
  .lan-ve {
    font-size: 0.9rem;
    margin-bottom: 1.2rem;
  }
  /* Điều kiện camera rút gọn — đứng NGAY TRÊN nút tải (FR-015). Viền cam
     cùng màu nút "Camera đề xuất" để mắt nối được hai thứ với nhau. */
  .dieu-kien {
    border-left: 3px solid var(--cam);
    padding: 0.55rem 0 0.55rem 0.9rem;
    margin: 1.4rem 0 0;
    max-width: 42rem;
    color: var(--chu-diu);
    font-size: 0.98rem;
  }
  /* Liên kết trong dòng này PHẢI gạch chân: nó nằm lọt giữa câu chữ xám, chỉ
     khác màu 1,63 lần — người mù màu không thấy đó là chỗ bấm được. Gạch chân
     là dấu hiệu thứ hai không phụ thuộc màu (WCAG 1.4.1). Đừng bỏ cho gọn. */
  .dieu-kien a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Cỡ file + hệ điều hành ghi ngay trên nút: shop dùng 3G/4G cần biết tải
     nặng bao nhiêu TRƯỚC khi bấm, và biết ngay máy mình có chạy được không.
     Nhỏ và mờ hơn chữ nút để không tranh chỗ với lời mời bấm. */
  .co-file {
    display: block;
    font-size: 0.72rem;
    font-weight: 400;
    opacity: 0.72;
    margin-top: 0.15rem;
  }
  /* Hai nút cạnh nhau; màn hình hẹp thì tự xuống dòng chứ không tràn ngang */
  .cho-nut {
    margin: 1.2rem 0 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .gioi-thieu-tb {
    margin-top: 1.4rem;
  }
  .nut--to {
    display: inline-block;
    font-size: 1.15rem;
    padding: 1rem 2.4rem;
  }
  .nut--sap-co {
    background: transparent;
    border: 1px dashed var(--vien);
    color: var(--chu-mo);
    cursor: default;
  }
  .ghi-chu {
    font-size: 0.9rem;
    max-width: 42rem;
  }
  .the-app p {
    font-size: 0.95rem;
    color: var(--chu-diu);
    margin-bottom: 0.6rem;
  }
  .the-app p:last-child {
    margin-bottom: 0;
  }
  .the-app .them {
    color: var(--chu-mo);
  }
  .doan {
    margin-bottom: 1.6rem;
  }
  .dan-nhap {
    color: var(--chu-diu);
    margin-bottom: 1.4rem;
    max-width: 42rem;
  }
  /* auto-FILL chứ không auto-fit: từ 19/08/2026 chỉ còn MỘT camera đề xuất,
     auto-fit sẽ kéo thẻ duy nhất giãn hết chiều ngang khung — ảnh 12rem nằm
     lọt thỏm trong thẻ rộng gấp ba. auto-fill giữ thẻ đúng bề ngang một cột.
     Thêm camera thứ hai vào lại thì cách xếp không đổi gì. */
  .luoi-tb {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    margin-bottom: 1rem;
  }
</style>
