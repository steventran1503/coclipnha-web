<script>
  import {
    type TrangThaiBang,
    layChuBang,
    layGoiYBang,
    layMauBang,
  } from "../lib/nguonSuThat";

  const giamCD = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Băng bám đỉnh: đổi theo mục đang cuộn tới (FR-004). "nen" là màu chương
  // trình trung tính (thương hiệu), không phải trạng thái app thật nên không
  // qua nguonSuThat.ts — các trạng thái còn lại đều đọc từ đó (FR-006). Chữ
  // băng CÓ nối mã đơn lúc "rec", đúng như app thật hiển thị.
  const bang = document.getElementById("bang-trang");
  function datBang(loai: string, maDon?: string) {
    if (!bang) return;
    const chu = bang.querySelector<HTMLElement>('[data-vai="chu"]');
    const goiY = bang.querySelector<HTMLElement>('[data-vai="goi-y"]');
    if (loai === "nen") {
      bang.dataset.trangThai = "nen";
      bang.style.setProperty("--bang-nen", "var(--nen-app)");
      bang.style.setProperty("--bang-chu", "var(--chu-mo)");
      if (chu) chu.textContent = "CoClipNha";
      if (goiY)
        goiY.textContent =
          "Phần mềm ghi hình đóng gói — miễn phí cho shop Việt";
      return;
    }
    const ten = loai as TrangThaiBang;
    const mau = layMauBang(ten);
    bang.dataset.trangThai = ten;
    bang.style.setProperty("--bang-nen", mau.bg);
    bang.style.setProperty("--bang-chu", mau.fg);
    if (chu) chu.textContent = layChuBang(ten, maDon);
    if (goiY) goiY.textContent = layGoiYBang(ten);
  }
  const cacMuc = document.querySelectorAll<HTMLElement>("[data-bang]");
  const quanSatBang = new IntersectionObserver(
    (es) => {
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        datBang(el.getAttribute("data-bang")!, el.dataset.ma);
      });
    },
    { rootMargin: "-45% 0px -45% 0px" },
  );
  cacMuc.forEach((m) => quanSatBang.observe(m));

  // GỠ 28/07/2026: trước đây có thêm một đoạn nghe sự kiện
  // "quetthu:trangthai" để băng bám đỉnh chạy theo kịch bản Quét thử 5 bước.
  // Kịch bản đó đã thay bằng video thật, không còn phát sự kiện nào nữa —
  // băng bám đỉnh giờ chỉ đổi theo mục đang cuộn tới (đoạn ngay trên).

  // Hiện dần khi cuộn tới (FR-004, FR-011) — cuộn vẫn tự do, không khóa/cướp
  // cuộn (FR-012): chỉ đổi opacity/transform bằng CSS, không chặn wheel/touch.
  // Không JS thì .an không bao giờ được thêm — phần tử hiện sẵn (FR-010).
  if (!giamCD) {
    const cacHien = document.querySelectorAll<HTMLElement>(".hien");
    cacHien.forEach((el) => el.classList.add("an"));
    const quanSatHien = new IntersectionObserver(
      (es) => {
        es.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.remove("an");
            quanSatHien.unobserve(e.target);
          }
        });
      },
      { rootMargin: "0px 0px -8% 0px" },
    );
    cacHien.forEach((el) => quanSatHien.observe(el));
  }
</script>
