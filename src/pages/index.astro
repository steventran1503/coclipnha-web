    <h2>{gp03.data.cau_chot}</h2>
    <p class="mo-dau" style="margin-bottom:1.6rem;">{gp03.data.dien_giai}</p>
    <div class="khung-minh-hoa hien">
      <span class="ghi-chu-khung">(bàn gói của shop)</span>
      <Watermark maDon={MA_DON_1} gioSong={true} />
    </div>
  </section>

  {/* ============ GP-02: TÌM LẠI VIDEO ============ */}
  <section class="khoi khoi--hep khoi--noi-full" data-bang="saved">
    <span class="nhan-log">lúc khách khiếu nại — tìm lại trong 5 giây</span>
    <h2>{gp02.data.cau_chot}</h2>
    <p class="mo-dau" style="margin-bottom:1.6rem;">{gp02.data.dien_giai}</p>
    {/* T062: chứng minh trực quan cho câu "dán vào, video hiện ra" */}
    <DongNhatKy
      dong={[
        { loai: "mo", text: `Thư mục video · tìm: ${MA_DON_1}` },
        { loai: "ok", text: `▸ ${FILE_GUI_DI}` },
        { loai: "ok", text: `▸ ${FILE_NHAN_VE}` },
        { loai: "mo", text: "— hai video: lúc gửi đi, và lúc mở hàng hoàn" },
      ]}
    />
  </section>

  {/* ============ GP-06 + GP-07 ============ */}
  <section class="khoi" data-bang="ready">
    <span class="nhan-log">còn ổ cứng thì sao?</span>
    <h2>{gp06.data.cau_chot}</h2>
    <div class="luoi" style="margin-top:1.6rem;align-items:start;">
      <div>
        <p class="mo-dau">{gp06.data.dien_giai}</p>
        <p class="mo-dau" style="margin-top:1rem;">
          <strong>{gp07.data.cau_chot}</strong>{" "}{gp07.data.dien_giai}
        </p>
      </div>
      <div>
        {/* T063: thẻ ổ cứng + dòng tự dọn — chữ và màu lấy từ app thật */}
        <div class="the-app the-app--teal hien" style="margin-bottom:1rem;">
          <div class="tieu-de-the">💾 Ổ lưu video (D:)</div>
          <div class="thanh-o">
            <div
              class="thanh-o-day"
              style={`background:${bangMau.dark.disk_ok};`}
            >
            </div>
          </div>
          <strong>Còn trống 377 GB — thoải mái</strong>
          <div class="chu-mo" style="font-size:.85rem;">
            Còn quay thoải mái nhiều tháng nữa
          </div>
        </div>
        <DongNhatKy dong={[{ loai: "vang", text: dongDonDep(40, 30, 512) }]} />
      </div>
    </div>
  </section>

  {/* ============ GP-05 ============ */}
  <section
    class="khoi khoi--hep khoi--noi-full khoi--teal-vien"
    data-bang="ready"
  >
    <span class="nhan-log">video của shop là của shop</span>
    <h2>{gp05.data.cau_chot}</h2>
    <p class="mo-dau">{gp05.data.dien_giai}</p>
  </section>

  {
    /* ============ TB-03: TIỀN BỎ RA vs TIỀN MẤT (đúng 1 dòng, FR-024) ====== */
  }
  <section class="khoi khoi--hep" data-bang="ready">
    <p class="cau-roi">{tb03.data.cau_chot}</p>
    <p class="chu-mo" style="font-size:.9rem;margin-top:.5rem;">
      {tb03.data.dien_giai}
    </p>
  </section>

  {/* ============ BC-01 (doi ngu) + TN ============ */}
  <section class="khoi" data-bang="warn">
    <span class="nhan-log">vì sao có phần mềm này</span>
    <h2>{bc01.data.cau_chot}</h2>
    <p class="mo-dau" style="margin-bottom:2rem;">{bc01.data.dien_giai}</p>
    <div class="the-app the-app--vang hien" style="margin-bottom:1.4rem;">
      <div class="tieu-de-the">Vì sao băng phía trên đang vàng?</div>
      <p style="font-size:.95rem;color:var(--chu-diu);">
        Đó là cảnh báo <strong>{tn05.data.cau_chot.toLowerCase()}</strong>:{" "}
        {tn05.data.dien_giai}
      </p>
    </div>
    <h3 style="margin-bottom:.8rem;">Và những thứ nhỏ mà chạm việc thật:</h3>
    <div style="overflow-x:auto;">
      <table class="bang-tn hien">
        {
          tn.map((k) => (
            <tr>
              <td>{k.data.cau_chot}</td>
              <td>{k.data.dien_giai}</td>
            </tr>
          ))
        }
      </table>
    </div>
  </section>

  {/* ============ NGƯỜI DÙNG ĐẦU TIÊN ============ */}
  <section class="khoi" data-bang="nen">
    <span class="nhan-log">người dùng đầu tiên</span>
    <h2>
      Người dùng đầu tiên <span class="diem-teal">vẫn đang dùng mỗi ngày</span>
    </h2>
    <div class="hien" style="margin-top:1.6rem;">
      <NguoiDungDauTien />
    </div>
  </section>

  {/* ============ SM-01 ============ */}
  <section
    class="khoi khoi--hep khoi--noi-full khoi--teal-vien"
    data-bang="nen"
    style="text-align:center;"
  >
    <span
      class="logo-c"
      style="width:2.2rem;height:2.2rem;border-width:5px;margin:0 auto 1.2rem;display:block;"
      aria-hidden="true"></span>
    <h2 style="max-width:22ch;margin:0 auto 1rem;">{sm01.data.cau_chot}</h2>
    <p class="mo-dau" style="margin:0 auto;">{sm01.data.dien_giai}</p>
  </section>

  {/* ============ VD-01 ============ */}
  <section class="khoi khoi--hep" id="video-that" data-bang="nen">
    <span class="nhan-log">nói thì hay — thật không?</span>
    <h2>{vd01.data.cau_chot}</h2>
    <p class="mo-dau" style="margin-bottom:1.6rem;">{vd01.data.dien_giai}</p>
    <YoutubeFacade tieuDeVideo={vd01.data.cau_chot} videoId={VIDEO_HUONG_DAN} />
  </section>

  {/* ============ KG-01 ============ */}
  <section
    class="khoi khoi--hep khoi--noi-full"
    id="tai-ve"
    data-bang="ready"
    style="text-align:center;"
  >
    <h2>Tải CoClipNha về bàn gói của shop</h2>
    <p
      style="display:flex;gap:.8rem;flex-wrap:wrap;justify-content:center;margin-top:1.4rem;"
    >
      <a
        class="nut nut--chinh"
        href={duongDan("tai-ve/")}
        style="font-size:1.15rem;padding:1rem 2.4rem;"
        >{kg01.data.nut ?? kg01.data.cau_chot}</a
      >
      <a class="nut nut--vien" href={duongDan("ung-ho/")}>🎁 Ủng hộ CoClipNha</a
      >
    </p>
    <p class="chu-mo" style="font-size:.9rem;margin-top:.8rem;">
      {kg01.data.dien_giai}
    </p>
  </section>

  {/* ============ TG-01..06 + KN-02: TRỢ GIÚP ============ */}
  <section class="khoi" data-bang="nen">
    <span class="nhan-log">trợ giúp &amp; phản hồi</span>
    <h2>Cần gì thêm, vào đây</h2>
    <div class="luoi" style="margin-top:1.6rem;">
      {
        tg.map((k) => (
          <a class="the-link hien" href={duongDan(TG_SLUG[k.data.ma])}>
            <strong>{k.data.cau_chot}</strong>
            <span>{k.data.dien_giai}</span>
          </a>
        ))
      }
    </div>
    {
      /* T068: kênh hỏi nhanh (KN-02) — link m.me thật chờ chủ dự án cấp (FR-021) */
    }
    <div class="the-app the-app--teal hien hoi-nhanh">
      <div>
        <strong style="font-family:var(--font-tit);font-size:1.05rem;"
          >{kn02.data.cau_chot}</strong
        >
        <p style="font-size:.92rem;color:var(--chu-diu);margin-top:.2rem;">
          {kn02.data.dien_giai}
        </p>
      </div>
      <span class="nut nut--vien nut-cho"
        >💬 {kn02.data.nut} — đang chờ link</span
      >
    </div>
  </section>
</BaseLayout>

