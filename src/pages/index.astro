---
// Trang chủ (US1 + đợt vá Phase 3b) — ghép đúng bản đồ mục 9 kho-thong-diep.md:
// TIT-D (+ dòng 3 nhịp) → ND-02 → GP-04 → HD-01..03 → GP-01 + ND-04 + SS →
// GP-03 → GP-02 → GP-06,07 → GP-05 → TB-03 → BC-01 → TN (bảng) → SM-01 →
// VD-01 → KG-01 → TG-01..06 → KN-02.
// Mọi đoạn nội dung thực chất đọc qua layKhoi() (content collection T012),
// không hardcode chữ (FR-003) — chỉ nhãn/tiêu đề trang trí (eyebrow, "Bước
// 1/2/3"...) là chữ chương trình, không phải nội dung marketing.
import BaseLayout from "../layouts/BaseLayout.astro";
import BangTrangThai from "../components/app-mophong/BangTrangThai.astro";
import Watermark from "../components/app-mophong/Watermark.astro";
import DongNhatKy from "../components/app-mophong/DongNhatKy.astro";
import QuetThu from "../components/app-mophong/QuetThu.astro";
import YoutubeFacade from "../components/YoutubeFacade.astro";
import NguoiDungDauTien from "../components/NguoiDungDauTien.astro";
import { layKhoi } from "../lib/khoiNoiDung";
import { duongDan } from "../lib/duongDan";
import { dongDonDep, sinhTenFile, bangMau } from "../lib/nguonSuThat";

// Hai mã vận đơn Shopee THẬT của ZIN ZIN MOTOR (chủ dự án cấp 24-25/07/2026).
// Dùng ở mọi chỗ trang chủ minh hoạ một đơn cụ thể — không dùng mã tự đặt.
const MA_DON_1 = "SHOPEEVTPVN2606875138465";

// HAI video YouTube khác nhau, đừng lẫn (chốt 28/07/2026):
//  - VIDEO_DEMO (đầu trang, trong khung "Quét thử"): đoạn NGẮN quay màn hình
//    app chạy một ca gói hàng — trả lời câu "app chạy ra sao".
//  - VIDEO_HUONG_DAN (cuối trang, khối VD-01): đoạn ĐẦY ĐỦ hướng dẫn mọi tính
//    năng — trả lời câu "dùng thế nào".
// Cả hai là Tài sản chờ chủ dự án cấp (tests/tai-san-cho-cap.md mục 8a/8b):
// điền mã video vào đúng hằng số dưới đây là chạy, không phải sửa gì thêm.
const VIDEO_DEMO: string | undefined = undefined;
const VIDEO_HUONG_DAN: string | undefined = undefined;

const titD = await layKhoi("TIT-D");
const nd02 = await layKhoi("ND-02");
const nd04 = await layKhoi("ND-04");
const gp04 = await layKhoi("GP-04");
const hd = await Promise.all(["HD-01", "HD-02", "HD-03"].map(layKhoi));
const gp01 = await layKhoi("GP-01");
const gp02 = await layKhoi("GP-02");
const gp03 = await layKhoi("GP-03");
const gp06 = await layKhoi("GP-06");
const gp07 = await layKhoi("GP-07");
const gp05 = await layKhoi("GP-05");
const tb03 = await layKhoi("TB-03");
const bc01 = await layKhoi("BC-01");
const ss = await Promise.all(["SS-01", "SS-02", "SS-03", "SS-04"].map(layKhoi));
// TN-05 (chống quét trùng) tách riêng khỏi bảng — dùng làm thẻ giải thích
// "vì sao băng phía trên đang vàng" (mục này đặt data-bang="warn"), tránh
// hiện trùng 2 lần trên cùng trang (giống cách bản demo đã tách).
const tn05 = await layKhoi("TN-05");
const tn = await Promise.all(
  ["TN-01", "TN-02", "TN-03", "TN-04", "TN-06", "TN-07"].map(layKhoi),
);
const sm01 = await layKhoi("SM-01");
const sm02 = await layKhoi("SM-02");
// Dòng nhãn nhỏ trên tít: câu chốt SM-02 (thay câu cũ "phần mềm miễn phí
// cho bàn đóng gói của shop Việt", gỡ 19/08/2026 theo chủ dự án). Bỏ dấu
// chấm cuối cho khớp nhịp các nhãn khác — nhãn trên web không chấm câu.
const nhanHero = sm02.data.cau_chot.replace(/\.$/, "");
const kyTenSm02 = sm02.data.truong_khac["Ký tên"];
const vd01 = await layKhoi("VD-01");
const kg01 = await layKhoi("KG-01");
const kn02 = await layKhoi("KN-02");
const tg = await Promise.all(
  ["TG-01", "TG-02", "TG-03", "TG-04", "TG-05", "TG-06"].map(layKhoi),
);
const TG_SLUG: Record<string, string> = {
  "TG-01": "tro-giup/huong-dan/",
  "TG-02": "tro-giup/cau-hoi/",
  "TG-03": "tro-giup/tai-qr/",
  "TG-04": "tro-giup/gop-y/",
  "TG-05": "tro-giup/bao-loi/",
  "TG-06": "tro-giup/yeu-cau-phan-mem/",
};

/**
 * Tách ND-02 thành: đoạn mở đầu → 2 thẻ "Kiểu tráo thẳng"/"Kiểu dùng rồi trả"
 * → đoạn kết (T061). Đọc THẲNG từ khối ND-02, không chép tay lại chữ (FR-003):
 * hai kiểu đã được đánh dấu **in đậm** ngay trong kho thông điệp.
 *
 * Nếu sau này chủ dự án sửa ND-02 mất dấu in đậm, hàm rơi về trường hợp "không
 * tách được" và trả nguyên đoạn văn — mất bố cục 2 thẻ chứ KHÔNG mất chữ nào.
 */
function tachHaiKieu(text: string) {
  const phan = text.split("**");
  if (phan.length < 5) return { moDau: text, the: [], ket: "" };
  const moDau = phan[0].trim();
  const the: { tieuDe: string; than: string }[] = [];
  let ket = "";
  for (let i = 1; i + 1 < phan.length; i += 2) {
    let than = phan[i + 1].replace(/^:\s*/, "").trim();
    // Câu tổng kết đứng sau thẻ cuối (mở đầu bằng "Cả hai…") tách ra làm đoạn
    // kết; không khớp thì giữ nguyên trong thẻ — không bao giờ mất chữ.
    const cat = than.search(/(?:^|\s)Cả hai\b/);
    if (cat > -1) {
      ket = than.slice(cat).trim();
      than = than.slice(0, cat).trim();
    }
    // Trong kho, thân thẻ viết tiếp sau dấu hai chấm nên bắt đầu bằng chữ
    // thường ("…: shop gửi đi…"); tách ra đứng riêng thành câu thì phải viết hoa.
    than = than.charAt(0).toUpperCase() + than.slice(1);
    the.push({ tieuDe: phan[i].trim(), than });
  }
  return { moDau, the, ket };
}
const nd02Tach = tachHaiKieu(nd02.data.dien_giai);

// Hai video cùng một đơn, hai mốc giờ khác nhau (GP-02) — tên file sinh từ
// đúng khuôn `ten_file_video` trong nguồn sự thật, không gõ tay (FR-006).
const FILE_GUI_DI = sinhTenFile(MA_DON_1, "2026-07-10_09-12-30");
const FILE_NHAN_VE = sinhTenFile(MA_DON_1, "2026-07-18_16-45-02");
---

<BaseLayout
  tieuDe={`CoClipNha — ${titD.data.cau_chot}`}
  moTaMeta={titD.data.dien_giai}
>
  <BangTrangThai trangThai="ready" variant="trang" id="bang-trang" />

  {/* ============ HERO (TIT-D) ============ */}
  <header
    class="khoi"
    id="canh-hero"
    data-bang="nen"
    style="padding-top:2.4rem;"
  >
    <span class="nhan-log">{nhanHero}</span>
    <h1 class="tit-hero">
      {
        titD.data.cau_chot.split(". ").map((cau, i) => (
          <span class={i === 0 ? "" : "diem-teal"}>
            {i === 0 ? cau + "." : cau}
            <br />
          </span>
        ))
      }
    </h1>
    <p class="mo-dau" style="margin:1.2rem 0 1.3rem;">{titD.data.dien_giai}</p>

    {/* Dòng 3 nhịp (FR-022): tóm cả quy trình trong một hơi, ngay dưới tít */}
    <p class="ba-nhip may">
      <span>📦 quét mã vận đơn</span><span class="mui-ten" aria-hidden="true"
        >→</span
      ><span>🔴 máy tự quay</span><span class="mui-ten" aria-hidden="true"
        >→</span
      ><span>🎞 video mang tên mã đơn</span>
    </p>

    <p style="display:flex;gap:.8rem;flex-wrap:wrap;margin-bottom:2.4rem;">
      <a class="nut nut--chinh" href={duongDan("tai-ve/")}
        >{kg01.data.nut ?? kg01.data.cau_chot}</a
      >
      <a class="nut nut--vien" href="#video-that">Xem app chạy thật</a>
    </p>

    {
      /* SM-02 — lời cam kết miễn phí, đặt NGAY DƯỚI nút Tải về (chủ dự án chốt
        19/08/2026): chỗ shop nghi "tải xong có đòi tiền không" chính là lúc
        mắt chạm nút. Đặt trên nút là trả lời câu chưa ai hỏi, lại đẩy nút và
        khung Quét thử khỏi màn hình đầu trên điện thoại. */
    }
    <div class="the-app the-app--teal cam-ket">
      <p class="cau-cam-ket">{sm02.data.dien_giai}</p>
      {kyTenSm02 && <p class="ky-ten">{kyTenSm02}</p>}
    </div>

    <QuetThu videoId={VIDEO_DEMO} />
    <p class="chu-mo" style="font-size:.85rem;margin-top:.8rem;">
      ▲ Cảnh dựng lại từ giao diện thật: chữ, màu, tên file, dòng nhật ký lấy
      đúng từ phần mềm — shop tải về là gặp đúng màn hình này. {
        VIDEO_DEMO
          ? "Bấm nút để xem đoạn quay màn hình app chạy thật."
          : "Đoạn quay màn hình app chạy thật sẽ đặt ngay trong khung này."
      }
    </p>
  </header>

  {/* ============ ND-02: NỖI ĐAU ============ */}
  <section class="khoi khoi--hep khoi--noi-full khoi--do" data-bang="nen">
    <span class="nhan-log" style="color:var(--do);"
      >chuyện xảy ra khi chưa có gì làm chứng</span
    >
    <h2>{nd02.data.cau_chot}</h2>
    <p class="mo-dau">{nd02Tach.moDau}</p>
    {
      nd02Tach.the.length > 0 && (
        <div class="luoi" style="margin-top:1.6rem;">
          {nd02Tach.the.map((t) => (
            <div class="the-app the-app--do hien">
              <div class="tieu-de-the">{t.tieuDe}</div>
              <p style="font-size:.95rem;color:var(--chu-diu);">{t.than}</p>
            </div>
          ))}
        </div>
      )
    }
    {
      nd02Tach.ket && (
        <p style="margin-top:1.6rem;color:var(--chu-diu);">{nd02Tach.ket}</p>
      )
    }
  </section>

  {/* ============ GP-04: HÀNG HOÀN ============ */}
  <section class="khoi" data-bang="rec" data-ma={MA_DON_1}>
    {
      /* Nhãn này TRƯỚC ĐÂY viết "chưa đối thủ nào có" — bỏ đi (rà soát 28/07,
         D2): vừa là câu so sánh đối thủ mà FR-023 đã cấm, vừa là khẳng định
         không ai kiểm chứng được. */
    }
    <span class="nhan-log">khác biệt lớn nhất</span>
    <h2>{gp04.data.cau_chot}</h2>
    <p class="mo-dau" style="margin-bottom:1.6rem;">{gp04.data.dien_giai}</p>
    <div class="hai-canh hien">
      <div class="canh">
        <span class="nhan-canh">LÚC GỬI ĐI</span>
        {
          /* Vật thể trong khung phải NHÌN THẤY được tương phản nhau, nếu không
             câu "đặt cạnh nhau là thấy ngay bên trong đã đổi hay chưa" thành
             câu nói suông (T060). Ví dụ lấy đúng từ ND-02: sạc dự phòng ↔ quần cũ. */
        }
        <div class="vat vat--hop">HỘP SẠC<br />NGUYÊN SEAL</div>
        <Watermark maDon={MA_DON_1} gio="2026-07-10 09:12:30" />
      </div>
      <div class="canh canh--sau">
        <span class="nhan-canh">LÚC NHẬN VỀ</span>
        <div class="vat vat--quan">QUẦN CŨ<br />KHÔNG PHẢI HÀNG</div>
        <Watermark maDon={MA_DON_1} gio="2026-07-18 16:45:02" />
      </div>
    </div>
    <p class="chu-mo" style="font-size:.85rem;margin-top:.8rem;">
      ▲ Cảnh dựng lại để minh hoạ. Cùng một mã đơn — hai mốc giờ đóng sẵn trên
      hình.
    </p>
  </section>

  {/* ============ HD-01..03: BA BƯỚC ============ */}
  <section class="khoi khoi--noi-full" data-bang="ready">
    <span class="nhan-log">cách dùng — đúng ba bước, không có bước thứ tư</span>
    <h2>Việc của shop vẫn y như mọi ngày</h2>
    <div class="luoi" style="margin-top:1.6rem;">
      {
        hd.map((k, i) => (
          <div class="the-app the-app--teal hien">
            <div class="tieu-de-the">Bước {i + 1}</div>
            <p style="font-size:.95rem;color:var(--chu-diu);">
              {k.data.cau_chot}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  {/* ============ GP-01 + ND-04 + SS: BẢNG SO SÁNH ============ */}
  <section class="khoi khoi--hep" data-bang="rec" data-ma={MA_DON_1}>
    <span class="nhan-log">vì sao không đơn nào bị sót</span>
    <h2>{gp01.data.cau_chot}</h2>
    <p class="mo-dau">{gp01.data.dien_giai}</p>

    {/* FR-023: chỉ so với quay bằng điện thoại, KHÔNG so với đối thủ nào */}
    <h3 style="margin:2.4rem 0 .6rem;">{nd04.data.cau_chot}</h3>
    <p class="mo-dau" style="margin-bottom:1.4rem;">{nd04.data.dien_giai}</p>
    <div style="overflow-x:auto;">
      {
        /* th + scope: không phải trang trí — trình đọc màn hình phải đọc được
           "ô này thuộc cột CoClipNha, dòng ...", nếu để td trắng thì bảng chỉ
           là một đống chữ rời (Lighthouse: td-has-header, sửa ở T046). */
      }
      <table class="bang-tn bang-ss hien">
        <thead>
          <tr>
            <td></td>
            <th scope="col" class="cot-dt">Quay bằng điện thoại</th>
            <th scope="col" class="cot-ccn">CoClipNha</th>
          </tr>
        </thead>
        <tbody>
          {
            ss.map((k) => (
              <tr>
                <th scope="row">{k.data.cau_chot}</th>
                <td class="cot-dt">{k.data.dien_giai}</td>
