  .cau-roi {
    font-family: var(--font-tit);
    font-size: clamp(1.15rem, 3.2vw, 1.6rem);
    line-height: 1.4;
    border-left: 3px solid var(--teal);
    padding-left: 1rem;
  }
  .logo-c {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 2.5px solid var(--teal);
