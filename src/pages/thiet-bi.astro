---
// Trang "Thiết bị đề xuất" (chủ dự án chốt 28/07/2026).
//
// Vì sao tách thành trang riêng: danh sách camera sẽ đổi thường xuyên khi có
// đời mới. Có trang riêng thì chỗ nào cần cũng chỉ trỏ về đây, và mỗi lần đổi
// thiết bị chỉ sửa `src/data/thiet-bi-goi-y.json` một lần — trang này lẫn
// trang Tải về cùng đổi theo.
//
// Lời trên trang vẫn lấy từ kho thông điệp (FR-003): TB-01 nói yêu cầu bắt
// buộc, TB-02 nói chuyện gợi ý. Chỉ tên model / link / ảnh là dữ liệu sản
// phẩm, nằm ở file JSON kia.
import BaseLayout from "../layouts/BaseLayout.astro";
import TheThietBi from "../components/TheThietBi.astro";
import VanBan from "../components/VanBan.astro";
import { layKhoi } from "../lib/khoiNoiDung";
import { duongDan } from "../lib/duongDan";
import {
  thietBiGoiY,
  phuKienGoiY,
  manHinhGoiY,
  mayTinhGoiY,
  capNhatLanCuoi,
} from "../lib/thietBi";

const tb01 = await layKhoi("TB-01");
const tb02 = await layKhoi("TB-02");
// Câu "ngoài yêu cầu autofocus thì camera nào cũng chạy" — gọi ĐÍCH DANH nhãn
// (cụm truong_khac còn chứa ghi chú nội bộ, tuyệt đối không đổ cả cụm ra trang).
const tb01Them = tb01.data.truong_khac["Ngoài yêu cầu đó"];
---

<BaseLayout
  tieuDe="Thiết bị đề xuất cho bàn gói — CoClipNha"
  moTaMeta="Camera nào chạy tốt với CoClipNha: bắt buộc phải lấy nét tự động. Kèm giá đỡ, cỡ màn hình và máy tính nên chọn cho bàn đóng gói."
>
  <main class="khoi khoi--hep">
    <p class="lan-ve"><a href={duongDan()}>← Trang chủ</a></p>
    <span class="nhan-log">chọn thiết bị cho bàn gói</span>
    <h1>Thiết bị đề xuất</h1>

    <div class="the-app the-app--do yeu-cau">
      <div class="tieu-de-the">{tb01.data.cau_chot}</div>
      <p>{tb01.data.dien_giai}</p>
      {tb01Them && <p class="them">Ngoài yêu cầu đó, {tb01Them}</p>}
    </div>

    <h2>Mấy mẫu tụi mình đã chạy thử</h2>
    <p class="doan"><VanBan text={tb02.data.dien_giai} /></p>

    <div class="luoi-tb">
      {thietBiGoiY.map((tb) => <TheThietBi thietBi={tb} />)}
    </div>

    <p class="chu-mo ghi-chu">
      Danh sách soát lại lần cuối ngày {capNhatLanCuoi}. Có camera đời mới chạy
      tốt hơn thì tụi mình đổi ngay tại trang này.
    </p>

    <div class="the-app the-app--teal tan-dung">
      <div class="tieu-de-the">Thứ gì shop đang có thì cứ dùng lại</div>
      <p>
        Máy tính, màn hình, giá đỡ — cửa hàng có sẵn rồi thì không việc gì phải
        mua mới. Mấy mục dưới đây chỉ dành cho shop còn thiếu.
      </p>
      <p>
        Riêng <b>camera</b> thì nên mua đúng mẫu đội ngũ CoClipNha đề xuất ở trên:
        camera là chỗ quyết định video có đọc được mã vận đơn hay không.
      </p>
    </div>

    {
      /* Phụ kiện — đặt SAU phần camera và tách hẳn ra (chủ dự án chốt
         19/08/2026). Không trộn chung lưới với camera: camera là yêu cầu bắt
         buộc, giá đỡ chỉ là món cho tiện. Trang Tải về cố ý KHÔNG hiện mục
         này. Khối tự ẩn khi chưa đề xuất phụ kiện nào. */
      phuKienGoiY.length > 0 && (
        <>
          <h2>Gắn thêm cho tiện: giá đỡ camera</h2>
          <p class="doan">
            Không bắt buộc — camera kê tạm cũng quay được. Nhưng kẹp camera lên
            giá đỡ rồi kẹp giá đỡ vào mép bàn gói thì người đóng hàng đẩy camera
            tới chỗ nào cũng được, nhanh và gọn: đơn to đơn nhỏ đều chỉnh được
            khung hình vừa vặn ngay trong lúc gói.
          </p>

          <div class="luoi-tb">
            {phuKienGoiY.map((tb) => (
              <TheThietBi thietBi={tb} />
            ))}
          </div>
        </>
      )
    }

    {
      /* Màn hình cho bàn gói (chủ dự án chốt 22/08/2026). Đặt SAU giá đỡ và
         tách riêng khỏi mục đó: đây không phải món "gắn thêm cho tiện" mà là
         chuyện bố trí chỗ làm — bao nhiêu điểm gói thì bấy nhiêu màn hình.
         Trang Tải về cố ý KHÔNG hiện mục này (xem lý do ở lib/thietBi.ts).
         Khối tự ẩn khi chưa đề xuất màn hình nào. */
      manHinhGoiY.length > 0 && (
        <>
          <h2>Mỗi điểm gói một màn hình</h2>
          <p class="doan">
            Một máy tính chạy được nhiều điểm gói cùng lúc, mỗi điểm một camera
            riêng. Nhưng nhân viên đứng ở điểm gói nào cũng cần nhìn được màn
            hình của điểm đó, để biết máy đã bắt được mã đơn và đang quay hay
            chưa. Vậy nên: một điểm gói thì một màn hình, hai điểm gói thì hai
            màn hình — cắm thêm màn hình vào cùng một máy tính, mỗi người theo
            dõi đơn của mình, khỏi phải ngó sang chỗ người khác.
          </p>
          <p class="doan">
            Tụi mình khuyên <b>2 điểm gói trên một máy</b> là vừa đẹp,{" "}
            <b>tối đa 3 điểm</b>. Đông hơn nữa thì nên tách sang máy thứ hai.
          </p>
          <div class="the-app the-app--do yeu-cau khoi-xen">
            <div class="tieu-de-the">
              Màn hình 22 inch Full HD là đủ — đừng mua to hơn.
            </div>
            <p>
              Bàn gói chỗ nào cũng để hàng. Màn hình lớn hơn chỉ ăn thêm diện
              tích làm việc chứ không giúp gói nhanh hơn, mà giá lại cao hơn.
            </p>
          </div>

          <div class="luoi-tb">
            {manHinhGoiY.map((tb) => (
              <TheThietBi thietBi={tb} />
            ))}
          </div>
        </>
      )
    }

    {
      /* Máy tính cho bàn gói (chủ dự án chốt 22/08/2026). Đặt CUỐI vì đây là
         món shop hay có sẵn nhất — đọc tới đây rồi mới tính chuyện sắm máy.
         Hai link là MÁY CŨ: câu nói rõ chuyện đó nằm ngay trên lưới thẻ,
         KHÔNG được bỏ (xem lib/thietBi.ts → mayTinhGoiY). Khối tự ẩn khi
         chưa đề xuất máy nào. */
      mayTinhGoiY.length > 0 && (
        <>
          <h2>Máy tính cho bàn gói</h2>
          <p class="doan">
            CoClipNha nhẹ, máy văn phòng bình thường là chạy được. Shop đang có
            máy tính ở quầy thì cứ dùng máy đó. Phần dưới dành cho shop muốn sắm
            riêng một máy cho bàn gói.
          </p>

          <div class="the-app the-app--do yeu-cau khoi-xen">
            <div class="tieu-de-the">
              Hai máy dưới đây là máy cũ, không phải máy mới.
            </div>
            <p>
              Máy văn phòng đã qua sử dụng — rẻ hơn hẳn máy mới mà chạy
              CoClipNha vẫn dư sức. Tụi mình nói trước để shop biết mình đang
              xem cái gì. Muốn máy mới nguyên hộp thì mua ở đâu cũng được, không
              cần theo link này.
            </p>
          </div>

          <div class="luoi-tb">
            {mayTinhGoiY.map((tb) => (
              <TheThietBi thietBi={tb} />
            ))}
          </div>

          <div class="the-app the-app--teal cau-hinh">
            <div class="tieu-de-the">Cấu hình vừa đủ cho bàn gói</div>
            <p class="dong-cau-hinh">
              Intel Core i3-8100 · RAM 8 GB · SSD 256 GB
            </p>
            <ul>
              <li>
                <b>Nhớ dặn người bán chia thêm một ổ đĩa riêng khoảng 120 GB</b>{" "}
                rồi cho CoClipNha lưu video vào ổ đó. Video nằm gọn một chỗ, tìm
                lại nhanh, không lẫn với phần mềm trong máy.
              </li>
              <li>
                Đây chỉ là cấu hình <b>đề xuất</b>, không phải mức tối thiểu.
                Máy chip Intel đời 4 – 5 vẫn chạy tốt.
              </li>
            </ul>
          </div>
        </>
      )
    }

    <p class="hang-nut">
      <a class="nut nut--chinh" href={duongDan("tai-ve/")}
        >Tải CoClipNha về máy →</a
      >
    </p>

    <p class="lan-ve cuoi"><a href={duongDan()}>← Về trang chủ</a></p>
  </main>
</BaseLayout>

<style>
  h1 {
    font-family: var(--font-tit);
    font-size: clamp(1.7rem, 5vw, 2.4rem);
    margin-bottom: 1.2rem;
  }
  h2 {
    font-family: var(--font-tit);
    font-size: 1.3rem;
    margin: 2.2rem 0 0.7rem;
  }
  .lan-ve {
    font-size: 0.9rem;
    margin-bottom: 1.2rem;
  }
  .lan-ve.cuoi {
    margin: 2.4rem 0 0;
  }
  .yeu-cau p {
    font-size: 0.95rem;
    color: var(--chu-diu);
    margin-bottom: 0.6rem;
  }
  .yeu-cau p:last-child {
    margin-bottom: 0;
  }
  .yeu-cau .them {
    color: var(--chu-mo);
  }
  .doan {
    color: var(--chu-diu);
    margin-bottom: 1.4rem;
    max-width: 44rem;
  }
  /* auto-FILL chứ không auto-fit: từ 19/08/2026 chỉ còn MỘT camera đề xuất,
     auto-fit sẽ kéo thẻ duy nhất giãn hết chiều ngang khung — ảnh 12rem nằm
     lọt thỏm trong thẻ rộng gấp ba. auto-fill giữ thẻ đúng bề ngang một cột.
     Thêm camera thứ hai vào lại thì cách xếp không đổi gì. */
  .luoi-tb {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    margin-bottom: 1.2rem;
  }
  .tan-dung {
    margin: 1.2rem 0 0.4rem;
  }
  .tan-dung p {
    font-size: 0.95rem;
    color: var(--chu-diu);
    margin-bottom: 0.6rem;
  }
  .tan-dung p:last-child {
    margin-bottom: 0;
  }
  /* Khối dặn dò xen giữa hai mục ("22 inch là đủ", "đây là máy cũ"): dùng lại
     kiểu thẻ đỏ của khối yêu cầu camera đầu trang — đều là chỗ dễ mua sai,
     không phải đoạn văn thường. */
  .khoi-xen {
    margin-bottom: 1.4rem;
  }
  .cau-hinh {
    margin-bottom: 0.4rem;
  }
  .dong-cau-hinh {
    font-family: var(--font-tit);
    font-size: 1.05rem;
    margin-bottom: 0.7rem;
  }
  .cau-hinh ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--chu-diu);
    font-size: 0.95rem;
  }
  .cau-hinh li + li {
    margin-top: 0.5rem;
  }
  .ghi-chu {
    font-size: 0.88rem;
    /* 42rem (672px) với cỡ chữ 14px = 92 ký tự/dòng — quá dài (rà soát bố cục
       24/08/2026). 34em ≈ 68 ký tự, khớp luật chung trong global.css. */
    max-width: 34em;
  }
  .hang-nut {
    margin-top: 1.8rem;
  }
</style>
