---
// T037/T038 — US4 "Cân nhắc ủng hộ": KG-02 → BC-01.
//
// TÁCH VAI 21/08/2026 (chủ dự án chốt): trang tiền bạc KHÔNG nhắc tên cửa
// hàng nào. Đã gỡ thẻ đối tác ZIN ZIN MOTOR (BC-03) khỏi trang này — để nó
// ngay dưới mã chuyển khoản là shop đọc ra "tiền ủng hộ chảy về cửa hàng phụ
// tùng xe máy". BC-01 (đội ngũ phát triển) thì ở lại, đó mới là nơi nhận tiền.
// ĐỪNG gắn BC-03 vào đây lần nữa (LUẬT trong khối BC-03).
//
// ĐỔI 28/07/2026 (chủ dự án chốt): BỎ khối "Cách 2 — ủng hộ mà không tốn đồng
// nào" (mua camera qua link hoa hồng, khối KG-03) khỏi trang này. Lý do là
// chính chủ dự án nêu: đặt link camera dưới chữ "ủng hộ" khiến shop nghĩ mua
// camera là đã đỡ đủ rồi, trong khi khoản hoa hồng rất nhỏ — kết quả là mất
// luôn khoản ủng hộ thật. Nay trang này chỉ còn MỘT đường ủng hộ: chuyển
// khoản. Link camera vẫn sống ở trang Tải về và trang Thiết bị đề xuất, đúng
// vai trò "gợi ý thiết bị" chứ không phải "cách ủng hộ".
//
// Kèm theo: hồ sơ spec (US4 mô tả "2 cách ủng hộ") cần sửa cho khớp — đã ghi
// vào báo cáo rà soát 28/07.
import BaseLayout from "../layouts/BaseLayout.astro";
import VanBan from "../components/VanBan.astro";
import { layKhoi } from "../lib/khoiNoiDung";
import { duongDan } from "../lib/duongDan";

const kg02 = await layKhoi("KG-02");
const sm02 = await layKhoi("SM-02");
const bc01 = await layKhoi("BC-01");
const tt10 = await layKhoi("TT-10");
const tt11 = await layKhoi("TT-11");

// T038 — ảnh mã VietQR là Tài sản chờ cấp (data-model.md). Đặt file vào
// `public/anh/` rồi điền tên vào đây là hiện ảnh thật; còn null thì hiện ô
// vuông "đang chờ" đúng kích thước, không vỡ bố cục và không nói dối là đã có
// (FR-021).
const ANH_VIETQR: string | null = null;
---

<BaseLayout
  tieuDe="Ủng hộ CoClipNha"
  moTaMeta="CoClipNha luôn miễn phí, không khoá tính năng nào. Ai thấy có ích thì ủng hộ tùy tâm bằng chuyển khoản — không ủng hộ vẫn dùng đủ."
>
  <main class="khoi khoi--hep">
    <p class="lan-ve"><a href={duongDan()}>← Trang chủ</a></p>
    <span class="nhan-log">miễn phí thật — ủng hộ tùy tâm</span>
    <h1>{kg02.data.nut ?? "Ủng hộ CoClipNha"}</h1>
    <p class="doan lon">{kg02.data.dien_giai}</p>

    {
      /* SM-02 — đặt TRƯỚC mã chuyển khoản: shop đang cân nhắc chuyện tiền,
        phải biết vì sao phần mềm miễn phí trước khi nhìn thấy mã ủng hộ. */
    }
    <div class="the-app the-app--teal cam-ket">
      <p class="cau-cam-ket">{sm02.data.dien_giai}</p>
      {
        sm02.data.truong_khac["Ký tên"] && (
          <p class="ky-ten">{sm02.data.truong_khac["Ký tên"]}</p>
        )
      }
    </div>

    <div class="cach-ung-ho">
      {/* Chuyển khoản VietQR — đường ủng hộ duy nhất trên trang (T038) */}
      <div class="the-app the-app--teal">
        <div class="tieu-de-the">{tt10.data.cau_chot}</div>
        {
          ANH_VIETQR ? (
            <img
              class="anh-qr"
              src={duongDan(`anh/${ANH_VIETQR}`)}
              alt="Mã VietQR ủng hộ CoClipNha — quét bằng app ngân hàng"
              width="220"
              height="220"
              loading="lazy"
            />
          ) : (
            <div class="khung-qr" role="status">
              <span class="o-qr" aria-hidden="true" />
              <p>Mã chuyển khoản sắp có — tụi mình đang chuẩn bị.</p>
            </div>
          )
        }
        <p class="nho">{tt10.data.dien_giai}</p>
      </div>
    </div>

    <h2>{tt11.data.cau_chot}</h2>
    <p class="doan"><VanBan text={tt11.data.dien_giai} /></p>
    <p class="doan">{bc01.data.dien_giai}</p>

    <p class="lan-ve cuoi"><a href={duongDan()}>← Về trang chủ</a></p>
  </main>
</BaseLayout>

<style>
  h1 {
    font-family: var(--font-tit);
    font-size: clamp(1.7rem, 5vw, 2.4rem);
    margin-bottom: 1.2rem;
  }
  h2 {
    font-family: var(--font-tit);
    font-size: 1.3rem;
    margin-bottom: 0.8rem;
  }
  .lan-ve {
    font-size: 0.9rem;
    margin-bottom: 1.2rem;
  }
  .lan-ve.cuoi {
    margin: 2.4rem 0 0;
  }
  .doan {
    color: var(--chu-diu);
    margin-bottom: 1.5rem;
    max-width: 44rem;
  }
  .doan.lon {
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }
  .cach-ung-ho {
    max-width: 26rem;
    margin-bottom: 2.4rem;
  }
  .nho {
    font-size: 0.93rem;
    color: var(--chu-diu);
    margin-bottom: 0.7rem;
  }
  .khung-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin: 0.8rem auto 1rem;
    text-align: center;
  }
  .khung-qr p {
    font-size: 0.8rem;
    color: var(--chu-mo);
    max-width: 15rem;
  }
  .o-qr,
  .anh-qr {
    width: 8.5rem;
    height: 8.5rem;
    border-radius: 8px;
    background: #0b0e14;
    border: 1px dashed var(--vien);
  }
  .anh-qr {
    display: block;
    margin: 0.8rem auto 1rem;
    border-style: solid;
    background: #fff;
    object-fit: contain;
  }
</style>
