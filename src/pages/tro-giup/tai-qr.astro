---
// T033/US3 — TG-03 Tải mã QR điều khiển.
//
// Tên hai mã đọc từ nguồn sự thật (`qr_dieu_khien`) chứ không gõ tay: app đổi
// nội dung mã là web hết lệch. File in A6/A4 là Tài sản chờ cấp — hiện nút
// "đang chuẩn bị", KHÔNG dùng href="#" và KHÔNG chép ghi chú nội bộ
// "(Demo — file in thật sẽ gắn khi phát hành.)" của bản demo (FR-021).
import TrangTroGiup from "../../layouts/TrangTroGiup.astro";
import VanBan from "../../components/VanBan.astro";
import { qrDieuKhien } from "../../lib/nguonSuThat";
import { duongDan } from "../../lib/duongDan";
import { layKhoi } from "../../lib/khoiNoiDung";

const tt02 = await layKhoi("TT-02");
const tt03 = await layKhoi("TT-03");
const tt04 = await layKhoi("TT-04");

// Đường tải thật khi có file in (đặt trong `public/in/`): điền vào đây là nút
// sống, không phải sửa chỗ nào khác.
//
// 19/08/2026 — chủ dự án cấp 2 ảnh mã QR (assets/ kho app), dựng thành PDF in
// khổ A6: 2 trang, mỗi trang một mã tràn khổ 105×148mm. Nghiệm thu: render lại
// PDF, quét bằng pyzbar ra đúng "START" và "PAUSE" — khớp app (gui/app.py:
// PAUSE so đúng chữ hoa, start so không phân biệt hoa thường).
//
// KHÔNG làm bản A4 xếp 4 mã (chủ dự án chốt 19/08/2026): shop cần mấy tờ thì
// chọn số bản ngay trong hộp thoại in, khỏi phải cắt.
const FILE_A6: string | null = "in/coclipnha-ma-qr-a6.pdf";

// Ảnh xem trước + bản JPG gốc để shop gửi Zalo cho nhân viên (không cần in).
const ANH = {
  pause: { xem: "anh/qr-dung.webp", tai: "in/qr-dung.jpg" },
  start: { xem: "anh/qr-bat-dau.webp", tai: "in/qr-bat-dau.jpg" },
};
---

<TrangTroGiup
  maTg="TG-03"
  moTaMeta="Tải mã QR điều khiển CoClipNha để in dán ở bàn quay: mã PAUSE (dừng và lưu video) và mã START Đơn Ngoài. File PDF khổ A6, in giấy nhiệt như mã vận đơn."
>
  <p class="doan">{tt02.data.cau_chot}</p>

  <div class="luoi">
    <div class="the-app">
      <div class="tieu-de-the">
        Mã <code>{qrDieuKhien.pause}</code> — dừng &amp; lưu
      </div>
      <img
        class="anh-ma"
        src={duongDan(ANH.pause.xem)}
        alt="Mã QR chữ DỪNG — đưa vào khung hình là video đang quay được lưu lại"
        width="260"
        height="338"
        loading="eager"
        decoding="async"
      />
      <p>{tt03.data.dien_giai}</p>
      <p class="tai-anh">
        <a href={duongDan(ANH.pause.tai)} download>Tải ảnh mã DỪNG</a>
      </p>
    </div>
    <div class="the-app">
      <div class="tieu-de-the">
        Mã <code>{qrDieuKhien.don_ngoai}</code> — Đơn Ngoài
      </div>
      <img
        class="anh-ma"
        src={duongDan(ANH.start.xem)}
        alt="Mã QR chữ BẮT ĐẦU — dùng khi cần quay mà không có mã vận đơn"
        width="260"
        height="338"
        loading="eager"
        decoding="async"
      />
      <p>{tt04.data.dien_giai}</p>
      <p class="tai-anh">
        <a href={duongDan(ANH.start.tai)} download>Tải ảnh mã BẮT ĐẦU</a>
      </p>
    </div>
  </div>

  <p class="doan"><VanBan text={tt02.data.dien_giai} /></p>

  <p class="hang-nut">
    {
      FILE_A6 ? (
        <a class="nut nut--chinh" href={duongDan(FILE_A6)} download>
          Tải bản in A6
        </a>
      ) : (
        <span class="nut nut--cho" role="status">
          Bản in A6 — đang chuẩn bị
        </span>
      )
    }
  </p>
  {
    !FILE_A6 && (
      <p class="ghi-chu chu-mo">
        File in đang được làm cùng bản cài chính thức. Trong lúc chờ, shop vẫn
        dùng app bình thường — hai mã này chỉ là tiện ích thêm, không có vẫn
        quay và lưu video đủ.
      </p>
    )
  }
</TrangTroGiup>

<style>
  .luoi {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin-bottom: 2rem;
  }
  .the-app p {
    font-size: 0.95rem;
    color: var(--chu-diu);
    margin: 0;
  }
  code {
    font-family: var(--font-may);
    font-size: 0.9em;
    color: var(--teal);
  }
  /* Ảnh mã đặt trên nền trắng cố định: mã QR phải là đen trên trắng mới quét
     được — nền thẻ đổi theo dark mode thì viền ảnh lẫn vào, nhìn như lỗi. */
  .anh-ma {
    display: block;
    width: 100%;
    max-width: 15rem;
    height: auto;
    margin: 0.9rem auto;
    background: #fff;
    border-radius: 6px;
  }
  .tai-anh {
    margin: 0.8rem 0 0;
    font-size: 0.9rem;
  }
  .tai-anh a {
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
