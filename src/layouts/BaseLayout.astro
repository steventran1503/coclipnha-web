---
import "../styles/global.css";
import MenuBaGach from "../components/MenuBaGach.astro";
import ChanTrang from "../components/ChanTrang.astro";
import { duongDan } from "../lib/duongDan";

interface Props {
  tieuDe: string;
  moTaMeta: string;
  /**
   * Trang khung chờ (bài viết chưa soạn xong) đặt cờ này = true: gắn thẻ
   * noindex để Google không xếp hạng một trang gần như trống. Trang trống bị
   * index sẽ kéo tụt đánh giá chất lượng của CẢ site, không chỉ riêng nó.
   * Bỏ cờ đi khi bài viết đã đầy đủ (đồng thời `daXong: true` ở baiViet.ts —
   * chính cờ đó cũng quyết định trang có vào sitemap hay không).
   */
  khongIndex?: boolean;
}

const { tieuDe, moTaMeta, khongIndex = false } = Astro.props;

// Địa chỉ chuẩn của trang (canonical) + thẻ chia sẻ mạng xã hội (OpenGraph).
// Kênh chính của dự án là Facebook: không có mấy thẻ này thì dán link lên
// nhóm sẽ ra một thẻ trơ, không tít không mô tả — người ta lướt qua luôn
// (rà soát 28/07, I3).
//
// Địa chỉ dựng từ `site` trong astro.config.mjs, nên khi DNS coclipnha.com
// trỏ xong (T002) và đổi `site` là mọi thẻ tự đúng theo, không phải sửa tay.
const diaChiTrang = new URL(Astro.url.pathname, Astro.site).href;

// ẢNH CHIA SẺ: chưa có (Tài sản chờ cấp). Cần một tấm 1200×630 đặt vào
// `public/anh/chia-se.jpg` rồi bỏ chú thích dòng dưới. Thà thiếu thẻ ảnh còn
// hơn khai một đường dẫn ảnh không tồn tại — Facebook sẽ hiện ô vỡ.
const ANH_CHIA_SE: string | null = null;

// Cloudflare Web Analytics (không cookie) — token thật lấy từ dashboard
// Cloudflare khi chủ dự án tạo site đo lường, đặt vào biến môi trường
// PUBLIC_CF_BEACON_TOKEN (.env, không commit). Chưa có token thì bỏ qua
// script, không gọi beacon rỗng/lỗi.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDe}</title>
    <meta name="description" content={moTaMeta} />
    {khongIndex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={diaChiTrang} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CoClipNha" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={tieuDe} />
    <meta property="og:description" content={moTaMeta} />
    <meta property="og:url" content={diaChiTrang} />
    {
      ANH_CHIA_SE && (
        <>
          <meta
            property="og:image"
            content={new URL(duongDan(`anh/${ANH_CHIA_SE}`), Astro.site).href}
          />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta
      name="twitter:card"
      content={ANH_CHIA_SE ? "summary_large_image" : "summary"}
    />
    {/* Nạp trước 3 file font THẬT SỰ dùng ở màn hình đầu (chữ thân bài
        thường + đậm, và font tiêu đề) — bản vietnamese vì trang toàn tiếng
        Việt. Không có mấy dòng này thì trình duyệt vẽ bằng font hệ thống rồi
        mới đổi sang font riêng, chữ nhảy một nhịp: đo được CLS 0,25 và điểm
        hiệu năng tụt còn 87 (Lighthouse 28/07). Đừng bỏ. Chỉ nạp trước 3 file
        — nạp trước cả 8 file lại giành băng thông của chính trang. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={duongDan("fonts/be-vietnam-pro-400-normal-vietnamese.woff2")}
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={duongDan("fonts/be-vietnam-pro-700-normal-vietnamese.woff2")}
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={duongDan("fonts/bricolage-grotesque-700-normal-vietnamese.woff2")}
    />
    <link rel="stylesheet" href={duongDan("fonts/fonts.css")} />
    <link rel="icon" type="image/svg+xml" href={duongDan("favicon.svg")} />
    <link rel="icon" href={duongDan("favicon.ico")} />
    <slot name="head" />
    {
      cfBeaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
        />
      )
    }
  </head>
  <body>
    {
      /* T055/FR-025: cả trang là cửa sổ CoClipNha phóng to — hồn cốt hướng
         "Ca trực" đã duyệt. Thanh này chỉ trang trí (aria-hidden), không phải
         điều khiển thật, nên không nhận tiêu điểm bàn phím.

         Ghi chú viết trong dấu ngoặc nhọn kiểu này, KHÔNG dùng comment HTML:
         comment HTML sẽ nằm nguyên trong trang đã xuất bản, ai xem mã nguồn
         cũng đọc được tên task nội bộ. Dạng này chỉ sống trong mã nguồn
         (rà soát 28/07, D1). */
    }
    <div class="thanh-win" aria-hidden="true">
      <span class="logo-c"></span>
      <span class="ten-win"
        >CoClipNha PRO v2.0 — Sponsored by ZIN ZIN MOTOR</span
      >
    </div>
    <MenuBaGach />
    <slot />
    <ChanTrang>
      <slot name="giay-phep" slot="giay-phep" />
    </ChanTrang>
  </body>
</html>

<style is:global>
  .thanh-win {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.9rem;
    /* Chừa chỗ bên phải cho nút menu ☰ (position:fixed, top:0.9rem
       right:1rem, rộng 2.2rem — xem MenuBaGach.astro) đang nổi đúng góc này.
       Không chừa thì ở đầu trang (chưa cuộn) nút ☰ đè lên cuối dòng chữ.
       Cùng lý do và cùng số đo với .bang-mophong--trang trong
       BangTrangThai.astro — sửa chỗ này thì ngó luôn chỗ kia. */
    padding-right: 3.6rem;
    background: #131822;
    border-bottom: 1px solid var(--vien);
    font-size: 0.72rem;
    color: var(--chu-mo);
  }
  /* Màn hình hẹp: hạ cỡ chữ để dòng "Sponsored by ZIN ZIN MOTOR" hiện ĐỦ,
     không bị cắt — tên nhà tài trợ phải đọc được trọn trên điện thoại.
     Trên 420px thì cỡ 0.72rem đã vừa, không cần hạ. */
  @media (max-width: 420px) {
    .thanh-win {
      font-size: 0.62rem;
    }
  }
  .thanh-win .ten-win {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .thanh-win .logo-c {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    border: 2.5px solid var(--teal);
    border-right-color: transparent;
    position: relative;
    flex: none;
  }
  .thanh-win .logo-c::after {
    content: "";
    position: absolute;
    inset: 25%;
    background: var(--do);
    border-radius: 1.5px;
  }
</style>
